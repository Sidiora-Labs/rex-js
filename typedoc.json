{
  "$schema": "https://typedoc-plugin-markdown.org/schema.json",
  "name": "@sidioralabs/rex API",
  "tsconfig": "packages/rex/tsconfig.json",
  "plugin": ["typedoc-plugin-markdown"],
  "entryPoints": [
    "packages/rex/src/index.ts",
    "packages/rex/src/config.ts",
    "packages/rex/src/schema/index.ts",
    "packages/rex/src/manifest/index.ts",
    "packages/rex/src/client/index.ts",
    "packages/rex/src/client/interop/index.ts",
    "packages/rex/src/client/media/index.ts",
    "packages/rex/src/client/i18n/index.ts",
    "packages/rex/src/server/index.ts",
    "packages/rex/src/server/node.ts",
    "packages/rex/src/server/adapters/bun.ts",
    "packages/rex/src/server/adapters/deno.ts",
    "packages/rex/src/server/adapters/edge.ts",
    "packages/rex/src/server-only.ts",
    "packages/rex/src/store/index.ts",
    "packages/rex/src/vite/index.ts",
    "packages/rex/src/check/index.ts",
    "packages/rex/src/testing/index.ts",
    "packages/rex/src/client/devtools/index.ts",
    "packages/rex/src/eslint/index.ts",
    "packages/rex/src/prettier.ts",
    "packages/rex/src/designx/index.ts"
  ],
  "out": "docs/api",
  "entryPointStrategy": "resolve",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "disableSources": true,
  "disableGit": true,
  "skipErrorChecking": true,
  "hideGenerator": true,
  "cleanOutputDir": true,
  "sort": ["kind", "alphabetical"],
  "outputFileStrategy": "modules",
  "entryFileName": "README.md",
  "hidePageHeader": true,
  "useCodeBlocks": true,
  "useHTMLAnchors": true,
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": false,
    "rewrittenLink": true,
    "unusedMergeModuleWith": true
  },
  "logLevel": "Error"
}
