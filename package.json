{
  "name": "rex-js",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter @sidioralabs/rex build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm --filter demo check",
    "dev": "pnpm --filter demo dev",
    "docs:errors": "node tools/docs-errors.mjs",
    "docs:api": "node tools/docs-api.mjs",
    "docs:check": "node tools/check-links.mjs && node tools/docs-api.mjs --check",
    "freshness": "node tools/freshness.mjs --check",
    "lint": "eslint .",
    "format": "prettier --config packages/rex/src/prettier.ts --write .",
    "format:check": "prettier --config packages/rex/src/prettier.ts --check .",
    "test:ratio": "node tools/test-ratio.mjs --check",
    "smoke": "sh tools/smoke-package.sh"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^5.9.3"
  }
}
