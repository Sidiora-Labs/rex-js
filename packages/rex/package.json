    },
    "eslint": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    },
    "marked": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
