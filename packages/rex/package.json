    "happy-dom": "^20.14.5",
    "marked": "^18.2.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "typescript": "^5.9.3",
