    "babel-plugin-react-compiler": "^1.0.0",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "wouter": "^3.13.0",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "@hono/node-server": {
      "optional": true
    },
    "@libsql/client": {
