{
  "name": "@sidioralabs/rex",
  "version": "0.1.0",
  "description": "Sidiora Labs' framework for web application interfaces that AI agents can write and operate.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": { "node": ">=22" },
  "bin": {
    "rex": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./server": "./src/server/index.ts",
    "./vite": "./src/vite/index.ts",
    "./check": "./src/check/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
      "./client": { "types": "./dist/client/index.d.ts", "import": "./dist/client/index.js" },
      "./server": { "types": "./dist/server/index.d.ts", "import": "./dist/server/index.js" },
      "./vite": { "types": "./dist/vite/index.d.ts", "import": "./dist/vite/index.js" },
      "./check": { "types": "./dist/check/index.d.ts", "import": "./dist/check/index.js" },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/fixtures"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs');for(const f of ['client/tokens.css','client/agent/density.css','vite/rex-app.d.ts'])fs.cpSync('src/'+f,'dist/'+f)\" && pnpm --dir ../.. install --frozen-lockfile --offline --ignore-scripts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@libsql/client": "^0.18.0",
    "@orpc/client": "^1.15.4",
    "@orpc/server": "^1.15.4",
    "@tanstack/react-query": "^5.104.1",
    "@vitejs/plugin-react": "^6.1.1",
    "cmdk": "^1.1.1",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "wouter": "^3.13.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3"
  }
}
