{
  "name": "@sidioralabs/rex",
  "version": "0.3.0",
  "description": "Sidiora Labs' framework for web application interfaces that AI agents can write and operate.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sidiora-Labs/rex-js.git",
    "directory": "packages/rex"
  },
  "homepage": "https://github.com/Sidiora-Labs/rex-js#readme",
  "bugs": {
    "url": "https://github.com/Sidiora-Labs/rex-js/issues"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "rex": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "rex-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "rex-source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./schema": {
      "rex-source": "./src/schema/index.ts",
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./manifest": {
      "rex-source": "./src/manifest/index.ts",
      "types": "./dist/manifest/index.d.ts",
      "default": "./dist/manifest/index.js"
    },
    "./client": {
      "rex-source": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./client/interop": {
      "rex-source": "./src/client/interop/index.ts",
      "types": "./dist/client/interop/index.d.ts",
      "default": "./dist/client/interop/index.js"
    },
    "./client/media": {
      "rex-source": "./src/client/media/index.ts",
      "types": "./dist/client/media/index.d.ts",
      "default": "./dist/client/media/index.js"
    },
    "./client/i18n": {
      "rex-source": "./src/client/i18n/index.ts",
      "types": "./dist/client/i18n/index.d.ts",
      "default": "./dist/client/i18n/index.js"
    },
    "./server": {
      "rex-source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server/node": {
      "rex-source": "./src/server/node.ts",
      "types": "./dist/server/node.d.ts",
      "default": "./dist/server/node.js"
    },
    "./server/bun": {
      "rex-source": "./src/server/adapters/bun.ts",
      "types": "./dist/server/adapters/bun.d.ts",
      "default": "./dist/server/adapters/bun.js"
    },
    "./server/deno": {
      "rex-source": "./src/server/adapters/deno.ts",
      "types": "./dist/server/adapters/deno.d.ts",
      "default": "./dist/server/adapters/deno.js"
    },
    "./server/edge": {
      "rex-source": "./src/server/adapters/edge.ts",
      "types": "./dist/server/adapters/edge.d.ts",
      "default": "./dist/server/adapters/edge.js"
    },
    "./server-only": {
      "rex-source": "./src/server-only.ts",
      "types": "./dist/server-only.d.ts",
      "default": "./dist/server-only.js"
    },
    "./store/drizzle": {
      "rex-source": "./src/store/index.ts",
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    },
    "./vite": {
      "rex-source": "./src/vite/index.ts",
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./check": {
      "rex-source": "./src/check/index.ts",
      "types": "./dist/check/index.d.ts",
      "default": "./dist/check/index.js"
    },
    "./check/catalog": {
      "rex-source": "./src/check/catalog.ts",
      "types": "./dist/check/catalog.d.ts",
      "default": "./dist/check/catalog.js"
    },
    "./testing": {
      "rex-source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./devtools": {
      "rex-source": "./src/client/devtools/index.ts",
      "types": "./dist/client/devtools/index.d.ts",
      "default": "./dist/client/devtools/index.js"
    },
    "./eslint": {
      "rex-source": "./src/eslint/index.ts",
      "types": "./dist/eslint/index.d.ts",
      "default": "./dist/eslint/index.js"
    },
    "./prettier": {
      "rex-source": "./src/prettier.ts",
      "types": "./dist/prettier.d.ts",
      "default": "./dist/prettier.js"
    },
    "./designx": {
      "rex-source": "./src/designx/index.ts",
      "types": "./dist/designx/index.d.ts",
      "default": "./dist/designx/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/fixtures"
  ],
  "scripts": {
    "typecheck": "node scripts/write-version.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/write-version.mjs && vitest run",
    "build": "node scripts/write-version.mjs && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs');for(const f of ['client/tokens.css','client/agent/density.css','vite/rex-app.d.ts'])fs.cpSync('src/'+f,'dist/'+f)\"",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@orpc/client": "^1.16.2",
    "@orpc/server": "^1.16.2",
    "@orpc/tanstack-query": "^1.16.2",
    "hono": "^4.13.18"
  },
  "peerDependencies": {
    "@babel/core": "^8.1.2",
    "@hono/node-server": "^2.1.8",
    "@libsql/client": "^0.18.0",
    "@opentelemetry/api": "^1.9.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/react": "^16.3.3",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.39.5 || ^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^20.14.5",
    "marked": "^18.2.0",
    "prettier": "^3.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.6.0",
    "typescript": "^5.9.3 || ^6.0.3",
    "vite": "^8.3.8",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
