      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "wouter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@hono/node-server": "^2.1.3",
    "@libsql/client": "^0.18.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@tanstack/react-query": "^5.104.1",
    "@testing-library/react": "^16.3.3",
