{
  "name": "@sidioralabs/rex",
  "version": "0.1.0",
  "description": "Sidiora Labs' framework for web application interfaces that AI agents can write and operate.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "rex": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./client": "./src/client/index.ts",
    "./server": "./src/server/index.ts",
    "./server/node": "./src/server/node.ts",
    "./server/bun": "./src/server/adapters/bun.ts",
    "./server/deno": "./src/server/adapters/deno.ts",
    "./server/edge": "./src/server/adapters/edge.ts",
    "./server-only": "./src/server-only.ts",
    "./store/drizzle": "./src/store/index.ts",
    "./vite": "./src/vite/index.ts",
    "./check": "./src/check/index.ts",
    "./testing": "./src/testing/index.ts",
    "./devtools": "./src/client/devtools/index.ts",
    "./eslint": "./src/eslint/index.ts",
    "./prettier": "./src/prettier.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "import": "./dist/config.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server/node": {
        "types": "./dist/server/node.d.ts",
        "import": "./dist/server/node.js"
      },
      "./server/bun": {
        "types": "./dist/server/adapters/bun.d.ts",
        "import": "./dist/server/adapters/bun.js"
      },
      "./server/deno": {
        "types": "./dist/server/adapters/deno.d.ts",
        "import": "./dist/server/adapters/deno.js"
      },
      "./server/edge": {
        "types": "./dist/server/adapters/edge.d.ts",
        "import": "./dist/server/adapters/edge.js"
      },
      "./server-only": {
        "types": "./dist/server-only.d.ts",
        "import": "./dist/server-only.js"
      },
      "./store/drizzle": {
        "types": "./dist/store/index.d.ts",
        "import": "./dist/store/index.js"
      },
      "./vite": {
        "types": "./dist/vite/index.d.ts",
        "import": "./dist/vite/index.js"
      },
      "./check": {
        "types": "./dist/check/index.d.ts",
        "import": "./dist/check/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js"
      },
      "./devtools": {
        "types": "./dist/client/devtools/index.d.ts",
        "import": "./dist/client/devtools/index.js"
      },
      "./eslint": {
        "types": "./dist/eslint/index.d.ts",
        "import": "./dist/eslint/index.js"
      },
      "./prettier": {
        "types": "./dist/prettier.d.ts",
        "import": "./dist/prettier.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/fixtures"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs');for(const f of ['client/tokens.css','client/agent/density.css','vite/rex-app.d.ts'])fs.cpSync('src/'+f,'dist/'+f)\" && pnpm --dir ../.. install --frozen-lockfile --offline --ignore-scripts"
  },
  "dependencies": {
    "@orpc/client": "^1.15.4",
    "@orpc/server": "^1.15.4",
    "@orpc/tanstack-query": "^1.15.4",
    "hono": "^4.13.12"
  },
  "peerDependencies": {
    "@babel/core": "^8.0.6",
    "@hono/node-server": "^2.1.3",
    "@libsql/client": "^0.18.0",
    "@opentelemetry/api": "^1.9.0",
