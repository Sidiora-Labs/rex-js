# rex — feature spec. Decisions, design, requirements, then the task list.
# Format: sectioned KV (.kvx). String values are ALWAYS double-quoted.

[meta]
feature    = "rex"
name       = "Rex"
slug       = "rex"
version    = "0.1.0"
status     = "draft"
intro      = "Rex is Sidiora Labs' framework for building complex, high-quality web application interfaces that AI agents can write and that AI agents can operate. One declaration per capability, one folder convention per page, one checker that fails the build when anyone steps outside them."
goal       = "Ship the Rex package, CLI and checker, and prove them with a demo app whose every page is operable by an agent driving a browser through the same UI a human uses."
scope      = "Core primitives (Entity, Action, Page, Policy, Flow), the page folder convention, server and client runtime, the agent contract (addressing, affordance sidecar, outcome region, palette, density), manifest generation, the checker, generators, and a demo application."
completion = "All acceptance criteria pass, rex check exits zero on the demo app, and the operability walk reaches every declared action through click, keyboard, URL and palette on one revision."

[decision]
problem          = "AI-generated apps degrade in proportion to the number of unforced micro-decisions per feature. Rex removes the decisions: one canonical shape per primitive, one folder layout per page, derived projections instead of hand-written glue."
not_next         = "Rex does not use Next.js, React Server Components or server actions. The server is Hono plus oRPC procedures; the client is React. The boundary is the Action declaration."
thin_runtime     = "Rex owns conventions, generators, the checker and the agent contract. It does not own a router, bundler or renderer. Vite, Hono, oRPC, TanStack Query, Drizzle and wouter are used as-is."
stack            = "TypeScript strict, React 19, Vite, Hono, oRPC, TanStack Query, zod, Drizzle, wouter, cmdk, Tailwind 4 tokens, DesignX UI components copied into app/components."
agent_interface  = "An agent interface is the human UI made legible and operable to an agent driving a browser or desktop. Every control carries a deterministic data-rex address; every page embeds an affordance sidecar; every action is reachable by click, keyboard, URL and command palette; state is visible as text, never only as color or motion."
one_dom          = "There is one DOM for humans and agents. Density and motion are preferences on the same components, never a separate agent view. The sidecar describes the visible UI and the checker fails any sidecar affordance without a visible counterpart."
derived_shell    = "The route table, header, navigation and back targets are derived from each page.ts declaration. No hand-written route switch, header switch or nav list exists."
no_callbacks     = "Parts and regions never receive navigation or action callbacks as props from a parent. They use the typed nav and act primitives bound to the manifest."
states_set       = "Every page can be in exactly one of nine data states: loading, empty, stale, partial, offline, permission-denied, recoverable-error, terminal-error, ready. states.tsx must export a component for each state the page declares; the type checker enforces it."
first_apps       = "The demo app is a wallet-like portfolio and send flow modelled on the Paxeer wallet widgets. Workmates and the Paxeer wallet are the first migration candidates after the demo."
package          = "One npm package @sidioralabs/rex with subpath exports: rex (core), rex/client, rex/server, rex/vite, rex/check, and the rex CLI binary."

[design]
overview            = "A Rex app is a directory of declarations plus React components. The Vite plugin discovers the app by convention and exposes it as a virtual module. The server mounts every Action as an oRPC procedure behind its Policy and records each call in the audit ledger. The client builds routes, navigation, palette, shortcuts and the sidecar from the same declarations. The checker reads the same structure and fails the build on violations. The manifest is the single generated artifact every projection reads."
primitives          = "Entity: schema, label, store adapter. Action: id, input, output, policy, effect, label, shortcut, handler. Page: id, route, params, policy, recovery, draft, actions, chrome, regions, overlays. Policy: named permission table and evaluation. Flow: durable multi-step action with approval gates. Manifest: generated description of all of the above."
page_folder         = "app/pages/<page>/page.ts (declaration), view.tsx (layout of regions only), states.tsx (one export per declared state), hooks/ (page-private state and queries), regions/<region>/region.tsx (binds hooks to parts; the only hook caller), regions/<region>/parts/*.tsx (pure, props in, events out), overlays/*.tsx (sheets, dialogs, drawers with declared dismissal), test/."
import_table        = "page.ts imports entities, actions, policies and never React. view.tsx imports regions and layout primitives and never hooks, data or parts. region.tsx imports its page's hooks, its own parts, its page's overlays and actions, never other regions or pages. parts import DesignX components and types, never fetching hooks, actions or navigation. hooks import app/data and actions, never components. overlays import parts and DesignX, never data fetching. states.tsx imports parts and DesignX, never hooks. No page imports another page."
addressing          = "data-rex=\"<page>/<action>\" on action controls, data-rex-region=\"<page>/<region>\" on region landmarks, data-rex-overlay=\"<page>/<overlay>\" on overlays, data-rex-page=\"<page>\" on the page root. Identifiers derive from declaration names, never from markup."
sidecar             = "One script element of type application/rex+json with id rex-page per rendered page. Payload: page id, params, data state, actions (id, label, allowed, effect, input JSON schema, via list of click, key, palette, url), overlays (id, open, dismiss), outcome (last action id, ok, message, at). It updates on every state change and is mirrored on window.__rex."
invocation          = "Every action is reachable four ways: a visible control, a keyboard shortcut from the declaration, a URL of the form <route>?act=<action id> with optional JSON input, and the cmdk command palette populated from the manifest. Irreversible actions require a confirmation step on all four routes."
outcome             = "A persistent outcome region per page (aria-live polite) states the last action, success or failure and message. Transient toasts are not used for action results."
density             = "A density preference (default or agent) is read from the density query parameter, the x-rex-density header or a stored preference. Agent density flattens layout, disables non-essential motion, expands collapsed groups and enlarges hit targets. It is a data attribute on the root consumed by tokens, not a separate component tree."
traps               = "Hover-only, drag-only and canvas-only controls are forbidden unless a declared keyboard or typed equivalent exists. Every overlay declares dismissal. Every picker accepts typed input. Every infinite list has a paged route."
checker             = "rex check runs typecheck, boundary rules, state rules, parity rules, naming rules, trap rules and emits JSON findings with file, line, rule id, message and fix hint. Exit code 1 on any error finding."
generators          = "rex new, rex make page|region|part|overlay|action|entity|policy|flow, rex promote. Every skeleton is the canonical shape. Generators refuse to overwrite existing files."
manifest            = "rex manifest writes .rex/manifest.json (deterministic ordering) and AGENTS.md from the declarations. Codify and Gideon read the manifest instead of crawling the repo."
server              = "createRexServer builds a Hono app: oRPC RPCHandler at /rex/rpc over the action router, GET /rex/manifest, policy evaluation before every handler, audit record after every handler, actor resolved from a pluggable context function."
client              = "createRexApp mounts providers (QueryClient, oRPC link, manifest, density), a wouter router from page declarations, the shell (header, nav, outcome, palette, sidecar) and the active page's view with its regions and states."
storage             = "Entity declares a zod schema; a store adapter interface provides get, list, put, delete. An in-memory adapter ships first; a Drizzle adapter follows."

[documentation]
mode      = "auto"
status    = "pending"
audiences = ["user", "developer"]
targets   = ["README.md", "docs/**", "CONTRIBUTING.md", "CHANGELOG.md"]

[req.1]
title = "Declarative primitives with one canonical shape"
story = "As an agent writing a Rex app, I want each capability declared once in one known shape so that I never choose between patterns."
ac_1  = "entity(), action(), page(), policy() and flow() each accept exactly one declaration object whose shape is exported as a TypeScript type and validated at declaration time; a malformed declaration throws with the field name."
ac_2  = "Every declaration carries a stable string id derived from its name; two declarations with the same id in one app throw at registry build time."
ac_3  = "Declarations contain no React imports and are importable from both server and client bundles."

[req.2]
title = "Action projections"
story = "As an agent, I want one Action declaration to produce every surface it needs so that no route, hook, palette entry or audit record is written by hand."
ac_1  = "Each Action becomes one oRPC procedure with input and output validation from its schemas; the procedure name equals the action id."
ac_2  = "Each Action is callable from the client through a typed act() hook that returns a TanStack mutation, invalidates the queries the action declares, and records the result in the outcome region."
ac_3  = "Each Action with a label appears in the command palette; each Action with a shortcut is bound to that key combination while its page is active."
ac_4  = "Each Action is invocable by URL: <page route>?act=<action id>&input=<json>; invalid input renders a validation outcome, it does not throw."
ac_5  = "Each Action invocation on the server writes one audit record with actor, action id, input digest, outcome, effect class and timestamp."
ac_6  = "Each Action with effect irreversible requires a confirmation step before the handler runs on all four invocation routes."

[req.3]
title = "Page folder convention"
story = "As an agent, I want the files of a page to be discoverable by name so that the folder tree is the component tree."
ac_1  = "A page directory contains page.ts, view.tsx, states.tsx and optionally hooks/, regions/<name>/region.tsx, regions/<name>/parts/*.tsx, overlays/*.tsx and test/; the Vite plugin resolves these by convention without barrels."
ac_2  = "Every region named in page.ts regions has a regions/<name>/region.tsx file, and every regions/<name> folder is named in page.ts; the checker reports either mismatch."
ac_3  = "Every overlay named in page.ts overlays has an overlays/<Name>.tsx file, and every overlays file is named in page.ts."
ac_4  = "Part files are PascalCase components with a single default export; hook files are camelCase starting with use and export a single function."
ac_5  = "A part shared by two pages is moved to app/components by rex promote; the checker reports a part imported from another page's folder."

[req.4]
title = "Required data states"
story = "As a user or agent, I want every page to render a sensible screen in every data state so that nothing is blank or spinning forever."
ac_1  = "The RexDataState type is the closed set loading, empty, stale, partial, offline, permission-denied, recoverable-error, terminal-error, ready."
ac_2  = "states.tsx must export a component named for every state the page declares in page.ts states (default: all nine); a missing export is a type error and a checker error."
ac_3  = "The runtime resolves the current state from the page's queries, policy result and connectivity, renders the matching export, and writes the state into the sidecar."
ac_4  = "The ready export is view.tsx; the other eight receive the page params and a retry function."

[req.5]
title = "Import boundaries"
story = "As a maintainer, I want layering enforced by the checker so that models cannot drift the architecture."
ac_1  = "The checker enforces the import table in [design] import_table for page.ts, view.tsx, region.tsx, parts, hooks, overlays and states.tsx."
ac_2  = "No file under app/pages/<a> imports from app/pages/<b> where a differs from b."
ac_3  = "No component file calls fetch, the oRPC client or a store adapter directly; data flows through hooks in hooks/ or app/data."
ac_4  = "Each violation is reported with file, line, rule id, the offending import and the allowed alternatives."

[req.6]
title = "Derived shell and typed navigation"
story = "As an agent, I want routes, header, nav and back behaviour to come from page declarations so that no shell switch is hand-written."
ac_1  = "The router is built from every page.ts route and params schema; unknown routes render the app-level not-found state."
ac_2  = "Header title, back target and nav visibility are read from page.ts chrome; the shell has no per-page switch statements."
ac_3  = "nav.to(page, params) is typed against the manifest; passing params that fail the target page's schema is a compile error and a runtime validation outcome."
ac_4  = "Page params and draft state live in the URL as declared by page.ts draft; a reload restores the same screen."
ac_5  = "A page whose policy denies the current actor renders its permission-denied state and the shell offers the page's declared recovery target."

[req.7]
title = "Stable addressing and affordance sidecar"
story = "As an agent driving a browser, I want to find every control by meaning and read what a page offers so that I never guess from pixels."
ac_1  = "Every action control renders data-rex=<page>/<action>, every region landmark renders data-rex-region=<page>/<region>, every overlay renders data-rex-overlay=<page>/<overlay>, the page root renders data-rex-page=<page>."
ac_2  = "Addresses are derived from declaration names and are identical across builds and style changes."
ac_3  = "Each rendered page contains exactly one script element with type application/rex+json and id rex-page whose payload matches the shape in [design] sidecar and validates against the published JSON schema."
ac_4  = "The sidecar payload updates within one render of any change to data state, action availability, overlay open state or outcome, and window.__rex holds the same object."
ac_5  = "Every action listed in the sidecar has a visible control in the DOM with a matching data-rex address while the action is available; the checker and the operability walk both report a mismatch."

[req.8]
title = "Four invocation routes"
story = "As an agent, I want every action reachable by click, keyboard, URL and command palette so that I can choose the cheapest route."
ac_1  = "Every action declared on a page is reachable by clicking its control, by its declared shortcut, by the URL act parameter and by selecting it in the palette."
ac_2  = "The palette opens with mod+k, lists the active page's actions and all navigable pages from the manifest, filters by label and id, and executes or navigates on enter."
ac_3  = "A disallowed action appears in the palette and sidecar as not allowed with the policy reason; it does not execute."

[req.9]
title = "Density and motion preference"
story = "As an agent or a user with accessibility needs, I want a flat, still, fully expanded layout on request without a separate UI."
ac_1  = "The density preference is resolved from the density query parameter, then the x-rex-density header, then the stored preference, then default."
ac_2  = "Agent density sets data-rex-density=agent on the root, which disables non-essential motion, expands collapsed groups, and enlarges hit targets to at least 44 by 44 CSS pixels through tokens."
ac_3  = "No state is conveyed only by color or motion; the checker reports a motion-only state change where detectable, and the demo passes a manual audit."

[req.10]
title = "No agent traps"
story = "As an agent, I want no control that requires hovering, dragging or a canvas so that I can always complete a task."
ac_1  = "The checker reports an onMouseEnter or onMouseOver handler without a matching onFocus handler, a draggable element without a declared keyboard alternative, and a canvas element without a declared equivalent action."
ac_2  = "Every overlay declares its dismissal; Escape and the declared dismiss control both close it; focus returns to the opener."
ac_3  = "Every date, token or entity picker accepts typed input in addition to selection."
ac_4  = "Every list that loads more on scroll also exposes a paged route with page and size params."

[req.11]
title = "Generated manifest"
story = "As Codify or Gideon, I want one machine-readable file describing the app so that I never crawl the source."
ac_1  = "rex manifest writes .rex/manifest.json containing every entity, action, page (with regions, overlays, states, chrome, route), policy and flow with deterministic key ordering."
ac_2  = "rex manifest writes AGENTS.md from the manifest with the page table, action table and the folder convention; a hand-edited AGENTS.md is overwritten and the checker warns when it is stale."
ac_3  = "The server serves the same manifest at GET /rex/manifest and the client reads it at startup."

[req.12]
title = "The checker"
story = "As an agent, I want one command whose structured failures tell me exactly what to fix so that red to green is mechanical."
ac_1  = "rex check runs typecheck, boundaries, states, parity, naming, traps and manifest freshness and exits 1 on any error finding."
ac_2  = "rex check --json emits an array of findings with rule, severity, file, line, column, message and hint; the human format prints the same findings grouped by file."
ac_3  = "Each rule is individually testable against fixture directories and has at least one passing and one failing fixture."
ac_4  = "rex check completes on the demo app in under 30 seconds on the reference machine."

[req.13]
title = "Generators"
story = "As an agent, I want skeletons written by the tool so that I only fill in handler bodies and parts."
ac_1  = "rex new <name> writes a complete app that passes rex check with zero findings."
ac_2  = "rex make page <id> --regions a,b --overlays X,Y writes page.ts, view.tsx, states.tsx with all nine exports, hooks/, regions/a/region.tsx, regions/b/region.tsx, overlays/X.tsx, overlays/Y.tsx and test/; the result passes rex check."
ac_3  = "rex make action|entity|policy|flow|region|part|overlay write the canonical skeleton at the conventional path and refuse to overwrite an existing file."
ac_4  = "rex promote <page>/regions/<region>/parts/<Part> moves the part to app/components and rewrites imports in the source page."

[req.14]
title = "Dev, build and single deployable"
story = "As a developer, I want one command to run the whole app and one artifact to deploy."
ac_1  = "rex dev starts one process serving the Vite client and the Hono server on one port with hot reload."
ac_2  = "rex build emits one directory containing the server entry and the client assets; node dist/server.js serves the app."
ac_3  = "rex dev and rex build fail fast with the checker's findings when rex check reports errors, unless --no-check is passed."

[req.15]
title = "Policy evaluation"
story = "As an operator, I want one permission table consulted by the server, the UI and the sidecar so that gating never disagrees."
ac_1  = "policy() declares named permissions and a resolver from actor to granted permissions; requires() and can() build policy predicates."
ac_2  = "The server evaluates the action's policy before the handler and returns FORBIDDEN with the reason when denied; the handler does not run."
ac_3  = "The client evaluates the same policy against the current actor to set allowed in the sidecar and disable controls, and the server result is authoritative on disagreement."

[req.16]
title = "Audit ledger"
story = "As an operator, I want every action invocation recorded so that agent activity is reviewable."
ac_1  = "The ledger interface exposes append and list with filters by actor, action id, outcome and time range; an in-memory implementation ships."
ac_2  = "Records contain actor, action id, input digest (sha-256 of canonical JSON), outcome ok or error code, effect class, duration and timestamp; raw input is not stored."
ac_3  = "A handler failure still writes a record with the error code."

[req.17]
title = "Flow primitive"
story = "As an agent harness, I want durable multi-step work with approval gates so that long tasks survive restarts and humans can sign off."
ac_1  = "flow() declares ordered steps, each an action or an approval gate, with a journal adapter; an in-memory journal ships."
ac_2  = "A flow instance records each completed step; resuming an instance continues from the first incomplete step."
ac_3  = "An approval gate pauses the flow, exposes an approve and reject action in the sidecar of the owning page, and resumes or terminates on decision."

[req.18]
title = "Operability walk"
story = "As a release engineer, I want proof that an agent can operate every page so that the contract is tested, not asserted."
ac_1  = "A Playwright script reads /rex/manifest, visits every page, and for every declared action verifies reachability by click, keyboard, URL and palette."
ac_2  = "The walk verifies that the sidecar lists exactly the actions whose controls are present, that every overlay declared is dismissible, and that the outcome region updates after each invocation."
ac_3  = "The walk emits a JSON report per page and exits 1 on any failure."

[req.19]
title = "Demo application"
story = "As the Rex team, I want a realistic app built only with the convention so that every rule is exercised."
ac_1  = "The demo declares at least two entities (account, token), four actions (send, pick token, pick contact, toggle hide dust), two policies and two pages (portfolio, send) with regions, overlays, hooks and all nine states."
ac_2  = "The demo passes rex check with zero findings and the operability walk with zero failures."
ac_3  = "The demo is generated with rex new and rex make and then filled in; no file deviates from the skeleton layout."

[req.20]
title = "Design tokens and components"
story = "As a designer, I want every visual value to come from tokens so that generated UI stays on-system."
ac_1  = "app/components holds DesignX UI copies; parts import only from app/components and the Rex layout primitives."
ac_2  = "The checker reports raw color classes, arbitrary values and inline style colors outside token references."
ac_3  = "Rex layout primitives Page.Stack, Page.Grid, Page.Section and Page.Outcome accept only token-based spacing props."

[req.21]
title = "Entity storage"
story = "As an app author, I want an entity to carry its schema and storage so that CRUD needs no hand-written glue."
ac_1  = "entity() derives the TypeScript type, zod validator and JSON schema from one field definition."
ac_2  = "The store adapter interface exposes get, list with filter and paging, put and delete; the in-memory adapter passes the adapter conformance test."
ac_3  = "The Drizzle adapter passes the same conformance test against libsql."

[req.22]
title = "Overlays"
story = "As an agent, I want every sheet and dialog declared, addressable and dismissible so that I am never trapped."
ac_1  = "overlay() wraps a component with id, declared dismiss behavior and open state bound to region state or URL."
ac_2  = "Open overlays appear in the sidecar with open true and the dismiss method; closed overlays appear with open false."
ac_3  = "An overlay traps focus while open, restores focus on close and renders data-rex-overlay."

[tasks]
heading = "Implementation Plan: Rex"

[task.0]
title   = "Foundation: workspace, core primitives, manifest"
section = "Wave 0"
status  = "pending"

[task.0.1]
title = "Scaffold the pnpm workspace and the @sidioralabs/rex package"
status = "done"
mode = "BUILD"
wave = 0
requires = []
reqs = ["1.1", "1.2", "1.3", "14.1", "14.2", "14.3"]
do_1 = "Finalize root package.json, pnpm-workspace.yaml, tsconfig.base.json, .npmrc and .gitignore for a pnpm 10 workspace with packages/* and examples/*; pin typescript ^5.9, vitest ^5, tsx ^4."
do_2 = "Create packages/rex/package.json named @sidioralabs/rex with type module, bin rex -> dist/cli/index.js, and the complete subpath exports map for ., ./client, ./server, ./vite and ./check pointing at src during development and dist after build; add typecheck, test and build scripts."
do_3 = "Create packages/rex/tsconfig.json extending the base with jsx react-jsx, packages/rex/vitest.config.ts with happy-dom for tsx tests, and packages/rex/src/index.ts exporting the core entry."
do_4 = "Create examples/demo/package.json named demo with dev, build, check and test scripts calling the rex bin, examples/demo/tsconfig.json, and examples/demo/index.html; run pnpm install and commit the lockfile."
touches = ["package.json", "pnpm-workspace.yaml", "pnpm-lock.yaml", "tsconfig.base.json", ".npmrc", ".gitignore", "packages/rex/package.json", "packages/rex/tsconfig.json", "packages/rex/vitest.config.ts", "packages/rex/src/index.ts", "examples/demo/package.json", "examples/demo/tsconfig.json", "examples/demo/index.html"]
verify_cmd = "pnpm install && pnpm -r typecheck"
gate_kind = "planned"
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result or time limit; record revision, command, exit code and log path. Do not mark done without the declared evidence."

[task.0.2]
title = "Implement deterministic identifiers and schema field helpers"
status = "done"
mode = "BUILD"
wave = 0
requires = ["0.1"]
reqs = ["1.1", "1.2", "1.3", "7.1", "7.2", "7.3", "7.4", "7.5", "21.1", "21.2", "21.3"]
do_1 = "Implement src/core/ids.ts: validateName (lowercase, digits, dot and dash, no leading digit), pageId, actionId, regionAddress(page, region), actionAddress(page, action), overlayAddress(page, overlay), pageAddress(page); addresses are pure functions of names."
do_2 = "Implement src/core/schema.ts: re-export zod as z, field helpers id(), text(), money(), integer(), boolean(), enumOf(), ref(entity), timestamp(); toJsonSchema(schema) producing draft 2020-12 JSON Schema for sidecar and manifest use."
do_3 = "Write src/core/ids.test.ts and src/core/schema.test.ts covering valid and invalid names, address stability across calls, and JSON schema output for every field helper."
touches = ["packages/rex/src/core/ids.ts", "packages/rex/src/core/schema.ts", "packages/rex/src/core/ids.test.ts", "packages/rex/src/core/schema.test.ts"]
verify_cmd = "pnpm -C packages/rex exec vitest run src/core/ids.test.ts src/core/schema.test.ts"
gate_kind = "planned"
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result or time limit; record revision, command, exit code and log path. Do not mark done without the declared evidence."

[task.0.3]
title = "Implement the Entity primitive, the store adapter interface and the memory store"
status = "done"
mode = "BUILD"
wave = 0
requires = ["0.2"]
reqs = ["1.1", "1.2", "1.3", "21.1", "21.2", "21.3"]
do_1 = "Implement src/core/entity.ts: entity(name, {fields, label, key}) returning schema (zod object), type inference helper, jsonSchema, label function and key field; malformed declarations throw naming the field."
do_2 = "Implement src/core/store.ts: Store interface with get(id), list({filter, page, size}), put(record), delete(id) and a bind(entity, store) helper; implement src/core/store.memory.ts as the in-memory adapter."
do_3 = "Implement src/core/store.conformance.ts exporting runStoreConformance(makeStore) used by every adapter test; write src/core/entity.test.ts and src/core/store.memory.test.ts that run the conformance suite against the memory store."
touches = ["packages/rex/src/core/entity.ts", "packages/rex/src/core/store.ts", "packages/rex/src/core/store.memory.ts", "packages/rex/src/core/store.conformance.ts", "packages/rex/src/core/entity.test.ts", "packages/rex/src/core/store.memory.test.ts"]
verify_cmd = "pnpm -C packages/rex exec vitest run src/core/entity.test.ts src/core/store.memory.test.ts"
gate_kind = "planned"
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
stop_condition = "Stop on the bounded gate result or time limit; record revision, command, exit code and log path. Do not mark done without the declared evidence."

[task.0.4]
title = "Implement the Policy primitive and evaluation"
status = "done"
mode = "BUILD"
wave = 0
requires = ["0.2"]
reqs = ["1.1", "1.2", "1.3", "15.1", "15.2", "15.3"]
do_1 = "Implement src/core/policy.ts: policy(name, {permissions, resolve(actor) -> granted set}); predicates requires({unlocked, account, custody, permissions}), can(permission), allOf, anyOf, always, never; evaluate(predicate, actor) -> {allowed, reason} with a stable reason code per failing clause."
do_2 = "Define the Actor type (id, roles, permissions, attributes) and the anonymous actor; evaluation is pure and identical on server and client."
do_3 = "Write src/core/policy.test.ts covering every predicate, combination, reason codes and the anonymous actor."
touches = ["packages/rex/src/core/policy.ts", "packages/rex/src/core/actor.ts", "packages/rex/src/core/policy.test.ts"]
verify_cmd = "pnpm -C packages/rex exec vitest run src/core/policy.test.ts"
gate_kind = "planned"
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 30
