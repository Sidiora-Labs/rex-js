title = "The routing contract: rest route segments, the not-found page folder prerendered as 404.html, 404 and 403 from loaders and params, and declared redirects on the client"
status = "pending"
mode = "BUILD"
wave = 3
requires = ["0.1", "1.1", "1.2", "1.3", "2.1", "2.2", "2.3", "2.5"]
