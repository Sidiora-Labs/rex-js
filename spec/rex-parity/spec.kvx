[task.3.2]
title = "Mutations drive every cache: the server action cache, regeneration of prerendered pages through invalidates, the paths fallback, and optimistic regions"
status = "pending"
mode = "BUILD"
wave = 3
requires = ["0.1", "1.1", "1.2", "1.3", "2.1", "2.2"]
