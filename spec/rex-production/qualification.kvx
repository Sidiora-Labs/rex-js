[meta]
feature = "rex-production"
status = "in_progress"
scope = "Focused task evidence is not full-domain or release certification."

[qualification.static_navigation_csp]
status = "open_browser_contract"
observation = "Native destination status, content and sidecars pass, but JavaScript-disabled Chromium reports 22 modulepreload request failures with reason csp even after nonce repair. Static host sends no CSP header; home has no CSP meta policy. Initial CSP-mismatch diagnosis was not established."
resolution = "Renderer nonce correctness qualified separately. Browser JavaScript-disabled preload behavior needs explicit contract analysis; request watcher and assertions remain unchanged."
evidence = "72cd5068fc64 | task 1.16 desktop no-JavaScript repair gate | running_with_failures | /tmp/rex-production-1.16-verify-repair.log"

