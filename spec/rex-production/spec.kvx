status = "unqualified"
remaining = "Task 1.8 corrects late error classification only; redaction, correlation propagation, production maps and cache/job metrics remain."
ac_1 = "Structured logs; correlation; loader/action traces; metrics; classification; production stacks; sampling/redaction; cache/slow request/job visibility."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.26]
title = "Resource and cost control"
status = "unqualified"
remaining = "Task 1.9 supplies local confirmation caps only; tenant quotas, input limits, database/image CPU and memory amplification remain."
ac_1 = "Memory/CPU/payload limits; bounded caches/logs; expensive queries; tenant quotas; image limits; amplification prevention."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

