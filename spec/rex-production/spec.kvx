ac_1 = "Phone/tablet/desktop; keyboards/safe areas; long strings; RTL/bidi; locale routes/plurals/timezones/Unicode/date and number formatting."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

