status = "unqualified"
remaining = "Task 1.19 aligns provenance metadata with the preserved release assertion; actual published attestation, upgrade/rollback and full supply-chain evidence remain."
ac_1 = "Semver; deprecation; upgrades/codemods; rollback/support/security reporting/advisories; updates/licenses; artifact provenance/integrity with SLSA baseline."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.34]
title = "Stable addressing"
status = "unqualified"
remaining = "Declaration addresses exist; repeated action instances lack item identity and need a compatible deterministic addressing contract."
ac_1 = "Deterministic unique addresses for controls/pages/regions/overlays; repeated and dynamic item identity; compatibility across releases."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.35]
title = "Machine-readable parity"
status = "unqualified"
remaining = "Declaration-derived sidecars lack per-instance operability proof; exposed store/parameter classification and pending outcome parity remain."
ac_1 = "Sidecars match visible operable UI, input, permission, reason and state; no stale navigation actions; no secrets or unnecessary personal data."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.36]
title = "Safe execution"
status = "unqualified"
remaining = "Tasks 1.9 and 1.10 protect local grants/consent; durable idempotency, replica grants, scoped credential and authorization matrices remain."
ac_1 = "Server authorization independent of sidecars; explicit effects; scoped credentials; exact-operation confirmation; retry duplicate-effect protection."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.37]
title = "Reliable automation"
status = "unqualified"
remaining = "Per-invocation machine state, correlation, cancellation and recovery after uncertain responses remain."
ac_1 = "Ready/pending/blocked/failed/completed states; machine-readable outcomes; cancellation/correlation/idempotency; interruption recovery; no arbitrary sleeps."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.38]
title = "Human control and auditability"
status = "unqualified"
remaining = "Task 1.10 binds visible consent to isolated input; navigation cancellation, delegated actor attribution, redaction and authority boundaries remain."
ac_1 = "Visible action parity; meaningful consent/intervention/cancellation; actor/delegator attribution; redacted audit; untrusted content never expands authority."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.39]
title = "Cross-request leakage"
status = "unqualified"
remaining = "Focused SSR store and cache policy repairs need a broader concurrent multi-tenant loader/action/query matrix."
ac_1 = "Concurrent users and tenants never share authenticated state, cached responses, mutable stores or loader results."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.40]
title = "Deployment version skew"
status = "unqualified"
remaining = "No real old-browser/new-server deployment-skew gate is qualified."
ac_1 = "Old browser tabs survive deployment without lost work, endless missing chunks or incompatible action calls."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.41]
title = "Replica behavior"
status = "unqualified"
remaining = "Confirmation grants remain per-router memory; multi-process sessions, caches, idempotency and scheduled work are unqualified."
ac_1 = "Sessions, invalidation, idempotency and scheduled work are tested across real processes, not only one local server."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.42]
title = "Races and disconnects"
status = "unqualified"
remaining = "Tasks 1.4, 1.5 and 1.10 cover selected races; uploads, disconnects, abort propagation and expensive dependency cleanup remain."
ac_1 = "Rapid navigation, late responses, double clicks, cancelled uploads and disconnections cannot corrupt state or leave unnecessary expensive work running."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.43]
title = "Streaming failures"
status = "unqualified"
remaining = "Current SSR allReady wait masks early delivery; real post-header failure and stream cancellation tests remain."
ac_1 = "Post-header failures have explicit reporting, recovery and observability; they cannot be represented as a replacement HTTP 500."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.44]
