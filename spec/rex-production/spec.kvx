[meta]
feature = "rex-production"
name = "Rex production qualification"
slug = "rex-production"
version = "0.3.0"
status = "in_progress"
goal = "Qualify Rex for static sites and dynamic applications using its own site and real application fixtures."
completion = "All 38 capability domains and 12 failure probes have complete acceptance evidence; partial safety repairs do not certify production readiness."

[decision]
architecture = "React clients, Hono servers and oRPC procedures retain the Action boundary. No RSC or Next.js runtime."
acceptance = "Requirements 1-38 are capability domains; 39-50 are explicit adversarial qualification probes. Source inspection, declarations and individual regression passes do not qualify a whole domain."
roadmap = "Existing rex-site and rex-parity work remains authoritative for its owned implementations. This spec adds production acceptance and scoped repairs without duplicating those APIs."
expanded_scope = "Base paths and nested layouts are now required for production acceptance despite older root-only and single-level exclusions. Their design and implementation remain pending; optional MDX and integrations require explicit supported contracts."
qualification = "Unproven platform and integration responsibilities remain unqualified, never silently treated as implemented or inapplicable."

[design]
proof = "Use real framework paths and actual artifacts; separate focused regression evidence from browser, release, multi-process, field and long-running evidence."

[baseline]
security = "OWASP ASVS 5.0.0; versioned control selection and applicability mapping remain pending. https://owasp.org/projects/asvs"
accessibility = "WCAG 2.2 AA, including manual qualification. https://www.w3.org/TR/WCAG22/"
performance = "Core Web Vitals methodology includes field measurements, not Lighthouse alone. https://web.dev/articles/vitals"
supply_chain = "SLSA v1.2 framework; no conformance level claimed. https://slsa.dev/spec/v1.2/"

[req.1]
title = "Architecture and contracts"
status = "unqualified"
remaining = "Public extension contracts are task 1.12; full lifecycle and compatibility qualification remains."
ac_1 = "Clear server/client boundaries; consistent pages, layouts, actions and data; explicit execution lifecycles; stable extension points; documented defaults and limitations."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.2]
title = "Routing"
status = "unqualified"
remaining = "Catch-all routes, nested layouts, redirects, base paths, normalization and typed URL edge cases need owned implementation; dotted routes are a confirmed candidate."
ac_1 = "Static, dynamic and catch-all routes; nested layouts; precedence and collision detection; typed URLs; redirects and real 404s; base paths; trailing slashes; query parameters; URL encoding and normalization."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.3]
title = "Rendering"
status = "unqualified"
remaining = "SSR currently awaits allReady; true early streaming and post-header failure recovery need implementation and real network proof."
ac_1 = "Reliable SSR, static generation and client rendering; explicit per-route behavior; supported streaming; deterministic and selective hydration where promised; error boundaries and correct status codes."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.4]
title = "Static output"
status = "unqualified"
remaining = "Static native forms with remote apiOrigin and CSRF need a declared supported contract; full route/static-host proof remains."
ac_1 = "Complete route enumeration; portable assets; working deep links and navigation; useful no-JavaScript pages; actual zero-JavaScript output when requested; no accidental backend dependency."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.5]
title = "Documents and SEO"
status = "unqualified"
remaining = "Shared head declarations and rendering depend on rex-parity 0.1 and 1.1; editorial noindex and resolved loader metadata remain."
ac_1 = "Per-page titles, descriptions, canonical URLs, social metadata, structured data, sitemap, robots, language attributes; merging and deduplication; previews excluded from indexing."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.6]
title = "Content workflows"
status = "unqualified"
remaining = "Build on rex-parity content groundwork; editorial draft preview/filtering, remote sources and relationship qualification remain."
ac_1 = "Validated schemas; Markdown and optional MDX; highlighting; local and remote sources; asset references; draft previews; pagination and relationships; document-specific build errors."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.7]
title = "Navigation and browser state"
status = "unqualified"
remaining = "Task 1.5 addresses deferred navigation races only; modifier clicks, scroll/anchors, bounded prefetch and broader cancellation remain."
ac_1 = "History; scroll, anchor and focus restoration; active navigation; deep-linkable filters; URL state; controlled prefetching; cancellation of obsolete navigation."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.8]
title = "Data loading"
status = "unqualified"
remaining = "Request deduplication, abort propagation, actor-aware client query identity and serialization edge cases need qualification."
ac_1 = "Server and client loaders; parallel execution; deduplication; serialization; loading, empty and error states; cancellation; freshness; explicit dates, big integers and unsupported values."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.9]
title = "Mutations and forms"
status = "unqualified"
remaining = "Task 1.4 addresses local duplicate admission only; file transport, structured field errors, optimistic rollback and durable retry safety remain."
ac_1 = "Server validation; field/form errors; pending state; duplicate protection; progressive enhancement where promised; files; optimistic updates and rollback; consistent outcomes."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.10]
title = "State management"
status = "unqualified"
remaining = "Task 1.6 isolates SSR declaration snapshots only; authenticated client reset, persistence/migrations and cross-tab behavior remain."
ac_1 = "Request-scoped server state; isolated client stores; hydration-safe values; persistence and migrations; cross-tab behavior; subscription cleanup; logout and tenant reset."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.11]
title = "HTTP correctness"
status = "unqualified"
remaining = "Task 1.1 closes unsafe RPC methods only; conditional requests, proxy trust, cookies and negotiation require broader tests."
ac_1 = "Methods, headers, cookies and negotiation; GET/HEAD consistency; statuses; conditional requests; cache headers; redirects; compression ownership; proxy behavior."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.12]
title = "Server APIs"
status = "unqualified"
remaining = "Body/multipart limits, deadline and cancellation propagation, streaming responses and API compatibility remain."
ac_1 = "Typed validated inputs/outputs; middleware ordering; error envelopes; cancellation/deadlines; body limits; multipart and streaming; API compatibility."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.13]
title = "Authentication integrations"
status = "unqualified"
remaining = "ActorResolver is an identity integration boundary, not a session/OIDC implementation; establish and test provider recipes and demo-safe defaults."
ac_1 = "Established identity systems; secure sessions/cookies; rotation and revocation; OAuth/OIDC; logout; recovery and reauthentication hooks; no invented cryptography."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.14]
title = "Authorization"
status = "unqualified"
remaining = "Tasks 1.2 and 1.13 guard cached documents; object/tenant input authorization and impersonation provenance remain application contracts needing tests."
ac_1 = "Server policies on every protected operation; object and tenant checks; consistent loaders/actions/APIs/alternate transports; explicit impersonation rules."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.15]
title = "Security defaults"
status = "unqualified"
remaining = "Task 1.3 addresses redirect normalization; versioned ASVS scope, upload/body limits, redaction and remaining attack surfaces remain."
ac_1 = "XSS-safe rendering/serialization; CSRF, CORS, CSP/nonces, SSRF, traversal, redirects, uploads, secret redaction; scoped OWASP ASVS baseline."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.16]
title = "Environment and secrets"
status = "unqualified"
remaining = "Typed env declarations and validation depend on rex-parity 0.1 and 3.3; packed bundle/map/sidecar/log secret scans and runtime rotation remain."
ac_1 = "Typed validation; public/server separation; build/runtime semantics; rotation; missing-variable failures; no secrets in bundles, maps, logs or agent manifests."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.17]
title = "Storage and transactions"
status = "unqualified"
remaining = "Task 1.18 qualifies native caller-owned transactions; pooling, migrations, safe pagination, deadlines and serverless capacity remain."
ac_1 = "Database boundaries; pooling; transaction propagation; migration ownership; timeouts; pagination and consistency; serverless connection exhaustion prevention."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.18]
title = "Background and real-time work"
status = "unqualified"
remaining = "No durable job or realtime contract is qualified; select established integrations and prove delivery/retry/replay/reconnect/shutdown."
ac_1 = "Supported queues/jobs/webhooks/SSE/WebSockets; delivery, idempotency, retry/backoff, replay protection, reconnect and shutdown; durable work independent of abandoned requests."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.19]
title = "Caching"
status = "unqualified"
remaining = "Document policy repairs do not provide locale/tenant cache variants, mutation invalidation, data caching or distributed regeneration coordination."
ac_1 = "Separate browser/CDN/page/data/request caches; keys; authenticated isolation; invalidation; bounds; stale behavior; distributed coordination; poisoning and stampede prevention."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.20]
title = "Runtime resilience"
status = "unqualified"
remaining = "Task 1.9 bounds confirmation grants only; admission, timeouts, cancellation, health semantics and graceful draining remain."
ac_1 = "Limits, timeouts, backpressure, bounded queues; dependency failures; degradation; cancellation; graceful shutdown/draining; readiness and liveness."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.21]
title = "Frontend performance"
status = "unqualified"
remaining = "Task 1.17 reports static transfer closures only; complete application budgets, hydration/images/fonts/layout-shift proof remain."
ac_1 = "Route splitting; tree shaking; server exclusion; hydration costs; images/fonts/CSS; bounded prefetch; no layout shifts or unnecessary requests."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.22]
title = "Measured budgets"
status = "unqualified"
remaining = "Warm dev preflight was previously measured at 15.8 seconds; startup/HMR/build/RSS field and slow-device regression gates remain."
ac_1 = "Cold/warm startup, HMR, build time, memory, bundles, TTFB, interactions; representative routes/devices/networks; regression tracking and field Core Web Vitals."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.23]
title = "Build system"
status = "unqualified"
remaining = "Task 1.11 preserves old output on build failure; true atomic publication, concurrent readers and reproducible clean/incremental artifacts remain."
ac_1 = "Deterministic manifests; reproducibility; dependency invalidation; clean/incremental builds; diagnostics; maps; hashing; atomic publication; explicit partial-build failures."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.24]
title = "Deployment"
status = "unqualified"
remaining = "Advertised runtime/host adapters, rollback, immutable version compatibility and real proxy/CDN behavior remain release qualification."
ac_1 = "Each advertised adapter tested; immutable artifacts; runtime config; health; filesystem/proxy/CDN assumptions; rollout/rollback; old-client/new-server compatibility."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.25]
