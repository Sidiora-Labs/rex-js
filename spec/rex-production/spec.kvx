ac_1 = "Unit/integration/browser/artifact/static/no-JS/security/accessibility/visual/performance/load tests; real server paths and installed packages; deterministic fixtures without fake success."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

