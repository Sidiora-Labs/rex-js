ac_1 = "WCAG 2.2 AA with manual testing: semantics, keyboard, focus, announcements, forms, modals, motion, contrast, zoom/reflow, touch targets; no hover-only controls."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

