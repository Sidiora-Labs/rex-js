[req.46]
title = "HTTP and path edge cases"
status = "unqualified"
remaining = "Tasks 1.1, 1.3 and 1.13 cover selected HTTP aliases/methods/redirects; malformed/Unicode/proxy/body/disconnect matrix remains."
ac_1 = "Real HEAD/OPTIONS, malformed URLs, encoded separators, Unicode, case-sensitive hosts, proxy headers, body limits and disconnected-stream tests."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.47]
title = "Actual npm artifact"
status = "unqualified"
remaining = "Task 1.14 qualifies minimal CLI install; complete packed app hydration, exports, CSS, types and production startup remain."
ac_1 = "Clean packed installs prove exports, CSS, types, CLI and production startup independently of workspace success."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.48]
title = "Static hosting reality"
status = "unqualified"
remaining = "Task 1.16 strengthens no-JS browser proof; base paths, directory redirects, forms, 404s and full static route matrix remain."
ac_1 = "Actual static host proves directory redirects, base paths, nested assets, 404s, no-JS navigation and forms."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.49]
title = "Long-running behavior"
status = "unqualified"
remaining = "No hours-long navigation/HMR/traffic/dependency-failure resource slope gate is qualified."
ac_1 = "Watchers/subscriptions/timers/caches/pools stay bounded through hours of navigation, HMR, traffic and dependency failures."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.50]
title = "Misleading green dashboards"
status = "unqualified"
remaining = "Task 1.15 enforces ratio and task 1.16 asserts real destinations; release claims still require aggregate behavioral evidence."
ac_1 = "Build success, HTTP 200, ready sidecar or Lighthouse alone never substitutes for correct, hydrated, accessible, authorized and operable pages."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[task.1.1]
title = "Reject unsafe RPC methods before execution"
status = "done"
mode = "BUILD"
wave = 1
requires = []
reqs = ["11","12","15","46"]
do_1 = "Allow RPC POST only; reject GET, HEAD, OPTIONS, PUT, PATCH and DELETE with 405 and Allow POST before actor/handler/audit; preserve configured CORS preflight and unknown POST fallthrough. Test real mutating action and encoded GET input."
touches = ["packages/rex/src/server/routes/rpc.ts","packages/rex/src/server/routes/rpc.test.ts"]
verify_cmd = "pnpm -C packages/rex exec vitest run src/server/routes/rpc.test.ts"
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 45

[task.1.2]
title = "Enforce page authorization before cached document delivery"
status = "in_progress"
mode = "BUILD"
wave = 1
requires = []
reqs = ["14","19","39","45"]
do_1 = "Authorize real declared pages before cache delivery; unknown cached declarations fail closed; denied actors receive 403 without cached content; retain public cache and stale/renderer-absent behavior."
touches = ["packages/rex/src/server/routes/render.ts","packages/rex/src/server/routes/render.test.ts"]
verify_cmd = "pnpm -C packages/rex exec vitest run src/server/routes/render.test.ts"
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 45

[task.1.3]
title = "Reject cross-origin redirect normalization"
status = "in_progress"
mode = "BUILD"
wave = 1
requires = []
reqs = ["15","46"]
do_1 = "Reject redirect values that normalize to another origin including backslashes and controls; same-origin Referer with double-slash pathname cannot produce external Location. Test real form responses and retain CSRF/Origin enforcement."
touches = ["packages/rex/src/core/action.ts","packages/rex/src/core/action.test.ts","packages/rex/src/server/form.ts","packages/rex/src/server/routes/form.test.ts"]
verify_cmd = "pnpm -C packages/rex exec vitest run src/core/action.test.ts src/server/routes/form.test.ts"
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 45

[task.1.4]
title = "Prevent duplicate client mutation admission"
status = "done"
mode = "BUILD"
wave = 1
requires = []
reqs = ["9","37","42"]
do_1 = "Synchronously guard a hook invocation before async validation; pending covers validation/token/execution; concurrent duplicates do not invoke handlers and return explicit non-success; all terminal outcomes release admission. This is not durable idempotency."
touches = ["packages/rex/src/client/act.ts","packages/rex/src/client/act.test.tsx"]
verify_cmd = "pnpm -C packages/rex exec vitest run src/client/act.test.tsx"
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 45

[task.1.5]
title = "Cancel obsolete deferred navigation commits"
status = "done"
mode = "BUILD"
wave = 1
requires = []
reqs = ["7","42"]
do_1 = "Latest navigation wins across deferred view transitions, ordinary navigation and unmount; stale callbacks cannot change history, route or focus. Use real DOM behavior without fake implementation success."
touches = ["packages/rex/src/client/router.tsx","tools/navigation-races.mjs","packages/rex/src/client/fixtures/navigation-races/index.html","packages/rex/src/client/fixtures/navigation-races/main.tsx"]
verify_cmd = "node tools/navigation-races.mjs && pnpm -C packages/rex exec vitest run src/client/navigation.test.tsx src/client/nav.test.tsx"
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 45

[task.1.6]
title = "Isolate SSR exposed store snapshots"
status = "in_progress"
mode = "BUILD"
wave = 1
requires = []
reqs = ["10","35","39","44"]
do_1 = "Per-render exposed stores use isolated declaration-initial snapshots consistent with server useStore, not module-global mutable client values; concurrent real SSR does not leak values and hydration agrees. Do not claim a new general request-scoped imperative state API."
touches = ["packages/rex/src/client/store.ts","packages/rex/src/client/store-registry.ts","packages/rex/src/client/store-registry.test.tsx","packages/rex/src/server/ssr.ts","packages/rex/src/server/ssr.test.tsx"]
