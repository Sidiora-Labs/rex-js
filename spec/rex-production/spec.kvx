ac_1 = "Installation through deployment; runnable examples; searchable errors; API/migration/adapter/extension contracts; application recipes and explicit unsupported behavior."
ac_2 = "Record executable evidence and explicit remaining gaps before marking this domain qualified."

[req.33]
