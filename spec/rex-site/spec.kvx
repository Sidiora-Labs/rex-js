# rex-site — rex.sidioralabs.com: the Rex marketing and documentation site, built with Rex.
# The site is the real test of the framework: every gap it exposes is fixed in packages/rex
# inside this feature. Format: sectioned KV (.kvx); strings double-quoted.

[meta]
feature    = "rex-site"
name       = "The Rex site, built with Rex"
slug       = "rex-site"
version    = "0.2.0"
status     = "in_progress"
intro      = "Rex 0.2 claims that an agent can write a web application interface with it and that an agent can operate the result. The site that explains Rex is built with Rex itself: the marketing home, the documentation, the error catalog, the API reference, the standards table and the changelog are Rex pages, rendered from the repository's own sources at build time, deployed as a static site to rex.sidioralabs.com, and gated by the same operability walk, accessibility pass and vitals gate as the demo."
goal       = "Ship rex.sidioralabs.com from the site/ workspace package: a Rex app whose every page is addressable and operable, whose content comes from docs/, the error catalog, docs/api, CHANGELOG.md and the standards list so it can never drift from the code, built by rex build --target static into a directory GitHub Pages serves, with the framework gaps the build exposes fixed in packages/rex and covered by tests."
scope      = "The site package and its pages, the content readers, the DesignX theme from the Rex mark, the static build target completed in packages/rex, the GitHub Pages deployment, the site gates and the framework fixes the site exposes."
completion = "pnpm -C site build --target static produces a directory that serves the whole site from a static host; the operability walk, the no-JS walk, axe, the vitals gate and Lighthouse pass on phone, tablet and desktop; rex check reports zero findings on the site; every REX error docs link the framework emits resolves on the deployed site; the Pages workflow on main is green; README links the site."

[decision]
dogfood        = "The site is an ordinary Rex app under site/ (package @sidioralabs/rex-site, private, workspace member) using @sidioralabs/rex through workspace:*. It uses only Rex primitives, the page folder convention and the DesignX standard set; it adds no second pattern for anything Rex already has one pattern for. A need the site has that Rex cannot meet is a framework task in this feature, never a workaround in the site."
domain         = "The site is served at the root of https://rex.sidioralabs.com, the host the framework already bakes into every error (REX_ERRORS_DOCS_BASE in packages/rex/src/core/errors.ts), so /errors/<code> must resolve there. GitHub Pages hosts it from the Sidiora-Labs/rex-js repository through a workflow deployment with site/public/CNAME set to rex.sidioralabs.com; the DNS CNAME record rex -> sidiora-labs.github.io is Andrew's. No base path: Rex apps are served from the root of a host."
rendering      = "Content pages (every doc, recipe, error, API page, the changelog, standards and about) render static: prerendered HTML with the sidecar as static JSON and zero page JavaScript, which is the proof that a Rex page works without JavaScript. The home, the docs index and the errors index render ssg so the command palette, the live sidecar region and the search work after hydration. There are no ssr or csr pages: the site has no server."
content        = "Site content is read from the repository at build time by read actions declared in load: docs/*.md and docs/recipes/*.md, docs/api/**/*.md, CHANGELOG.md, packages/rex/package.json for the version, the error catalog exported by the package, and spec/rex-v02/spec.kvx [standard.*] for the standards table. Nothing is copied into the site by hand, so the site cannot go stale; tools/freshness.mjs is not needed for it. Marketing copy on the home page is the only authored text and every claim in it names the feature it describes."
markdown       = "Markdown is rendered to HTML at build time by marked (MIT) with heading ids, a heading list for the table of contents, relative links between docs rewritten to site routes, and code blocks highlighted by shiki (MIT) on the server; the HTML reaches the page through unsafeHtml() in exactly one Prose part, which is the only dangerouslySetInnerHTML in the site and is allowed by the checker through that helper."
theme          = "The DesignX theme is derived from the Rex mark (assets/mark_rex_js.png, assets/light_mark_rex_js.png): a warm near-black background with cream, gold and orange-red accents in dark mode, the light mark on the light theme, system font stack with no web fonts, the mark as the favicon and the Open Graph image. Both color schemes are supported through DesignX theme-provider adapted outside the standard set, as rex-v02 designx_standard records."
static_target  = "rex build --target static becomes a complete static deployment: every page is prerendered (ssg and static pages through the prerender pipeline with their paths, ssr and csr pages as the shell HTML), the manifest is written as the JSON file rex/manifest so agents on a static host read the same manifest the server would answer, each prerendered page's text rendering is written next to it as index.md for terminal agents, a 404.html boots the shell for unknown routes, and the built client never requests a route the static host cannot answer. This is the framework task of this feature; the site workflow builds with it."
hosting_gates  = "The built directory is served the way Pages serves it, by tools/serve-static.mjs (no dependency: directory index resolution, 404.html, correct content types), for every e2e gate; the gates are the demo's: the operability walk that opens every popup trigger, the no-JS walk on the static pages, axe, the vitals thresholds LCP 2500 ms, CLS 0.1, INP 200 ms, Lighthouse performance 95, accessibility 100, best practices 95 and SEO 95, a link check over every internal href in the built HTML, and screen-fit assertions on phone (390 px coarse), tablet (820 px) and desktop (1440 px)."
analytics      = "The site loads no third-party script, no analytics and no fonts from a CDN: it is content-security-policy clean, and it is the reference for the security defaults Rex claims."
search         = "Search is a loader: the docs index page loads a search index (title, route, headings, first paragraph of every doc, recipe, error and API page) built by a read action at build time and dehydrated into the page; the search region filters it client side with the DesignX command item. The command palette lists every page as on any Rex app; there is no search service."
findings       = "Every framework gap the site exposes (a missing export, a checker rule that rejects a legitimate pattern, a route shape page() cannot express, a build output the static host cannot serve, a runtime request a static host cannot answer) is one entry in spec/rex-site/qualification.kvx with the exact observation (the log is shared and outside every task's touches, so any task appends to it), and task 3.3 fixes each in packages/rex with a test, or records a [decision] here when the framework is right and the site adapts. The task report of 3.3 is the list of what the site taught the framework."
workflow       = "The site has its own GitHub Actions workflow .github/workflows/site.yml: verify (install, build the package, rex check, unit tests, the static build) on every push and pull request touching site/, docs/, packages/rex/, CHANGELOG.md or the workflow; e2e on the built directory; deploy to Pages on main only, with the pages and id-token permissions and concurrency so one deployment runs at a time. ci.yml is not touched by this feature."

[design]
module_layout  = "site/: package.json (name @sidioralabs/rex-site, private, scripts dev, build, build:static, check, manifest, test, test:unit, test:e2e, lint, format), rex.config.ts (ui kit designx with components app/components/Shell.tsx, no i18n block, no server), index.html with the meta tags (title, description, canonical, Open Graph, theme-color), tsconfig.json, vitest.config.ts (happy-dom, include app/pages/*/test/** and app/server/**/*.test.ts), playwright.config.ts (phone, tablet and desktop projects, webServer node ../tools/serve-static.mjs dist/client), eslint.config.js, .prettierrc, public/ (CNAME, robots.txt, favicon.png and og.png from assets/, the mark in both variants), app/theme.css, app/components/ui/ (the DesignX standard set installed by rex new --ui designx, plus theme-provider adapted), app/components/Shell.tsx, app/components/Mark.tsx, app/components/Prose.tsx, app/components/CodeBlock.tsx, app/components/InstallBlock.tsx, app/server/content/ (docs.ts, errors.ts, api.ts, changelog.ts, standards.ts, search.ts, markdown.ts: file readers and the markdown renderer, never imported by a region), app/actions/<page>/ (one folder per page task: home, docs, errors, standards, changelog, api; one read action per content reader, so parallel tasks touch disjoint paths), app/pages/<page>/ per the convention, e2e/ (operability.spec.ts, nojs.spec.ts, axe.spec.ts, vitals.spec.ts, lighthouse.ts, screen-fit.spec.ts, links.spec.ts, walk.ts shared helpers), README.md explaining how the site builds and deploys."
pages          = "home at / (ssg): Hero, Pitch, Primitives, HowItWorks, Install, Features, LiveSidecar, Footer regions. docs at /docs (ssg): Index and Search regions. doc at /docs/:slug (static, paths from docs/*.md except README): Article and Toc regions. recipe at /docs/recipes/:slug (static, paths from docs/recipes/*.md except README): Article and Toc. errors at /errors (ssg): Catalog region grouped by area with the search. error at /errors/:code (static, paths from the catalog): Detail region with code, area, message, hint, the docs link it is emitted with and the source file that throws it when the catalog records one. api at /api (ssg): Entries region listing every package entry and its exports from docs/api. api-doc at /api/:slug (static, paths from docs/api/**/*.md with the path flattened to a dash-separated slug): Article and Toc. standards at /standards (static): Table region from spec/rex-v02/spec.kvx [standard.*] with each item's status and the owning tasks. changelog at /changelog (static): Releases region from CHANGELOG.md. about at /about (static): Sidiora, license, governance, contributing and security regions linking the repository files. Every page declares chrome.title and a back target; navigation is Docs, Errors, API, Standards, Changelog, About plus the GitHub link."
copy           = "Tagline: The UI framework agents can operate. Subline: Rex is Sidiora Labs' TypeScript framework for React application interfaces that AI agents write and AI agents operate, on a phone, a tablet or a desk. Pitch paragraphs name the four rules from README.md: one declaration per capability (entity, action, page, policy and flow, with the manifest derived), one folder convention per page, one checker (rex check), one DOM that humans and agents operate (data-rex addresses, the application/rex+json sidecar, four invocation routes: click, keyboard shortcut, URL and command palette). Feature cards, each naming the doc it links: rendering modes ssr, csr, ssg and static; loaders and forms that work without JavaScript; node, bun, deno and edge targets; the nine data states; the DesignX standard; screen-fit (phone, tablet, desktop, pointer and density); errors with REX codes and docs links; rex/testing; i18n; security defaults (CSP nonce, Origin checks, CSRF double-submit cookie); OpenTelemetry spans; budgets enforced by rex build; codemods with rex migrate. Install block: pnpm dlx @sidioralabs/rex new my-app, cd my-app, pnpm rex dev, with the version read from packages/rex/package.json at build time and a line saying 0.2.0 is published with the release. Every number quoted on the home page is read from the code at build time (the client budget from the package's rex.config defaults, the count of error codes from the catalog, the count of checker rules from the checker), never typed."
live_sidecar   = "The LiveSidecar region of the home page renders the home page's own sidecar: the same JSON the application/rex+json script carries, server-rendered from the sidecar registry so it is identical before and after hydration, in a CodeBlock with a caption that names the data-rex-page attribute and the script id, and a button that copies the sidecar address list. It is the live demonstration of the agent contract and is itself addressable."
data_flow      = "A page declares load with its read actions; the actions call the readers under app/server/content, which read the repository files relative to the site root (../docs, ../CHANGELOG.md, ../packages/rex/package.json, ../spec/rex-v02/spec.kvx) and the error catalog from the package; during rex build the loaders run in process in the prerender and are dehydrated into the HTML; on the static host no loader ever runs again. paths functions list every slug from the same readers so the set of prerendered pages is the set of source files."
shared_lists   = "site/rex.config.ts (check allow list), site/app/components/Shell.tsx (navigation items), site/package.json (scripts and dependencies), pnpm-workspace.yaml, .github/workflows/site.yml (jobs), spec/rex-site/qualification.kvx (sections)."
testing        = "Unit tests use rex/testing (createTestApp, renderPage, renderRegion, readSidecar) against the real registry and the real readers reading the real repository files: every page has a test folder asserting its regions render, its sidecar lists its actions and its paths list the sources. The e2e gates run against the built directory served by tools/serve-static.mjs."
static_build   = "packages/rex: buildApp with target static runs the prerender pipeline over every page (ssg and static with paths, ssr and csr as the shell document) into dist/client, writes dist/client/rex/manifest (the JSON the server route answers), dist/client/<route>/index.md from the text renderer for each prerendered page, dist/client/404.html as the shell document for unknown routes, and lists the files in dist/prerender.json; serverFile and manifestFile stay null. The client built for the static target reads the manifest inlined at build time and makes no request to /rex/manifest; on a page without actions it makes no request at all. docs/cli.md, docs/recipes/static-page.md and docs/platforms.md describe the output."

[documentation]
mode      = "auto"
status    = "pending"
audiences = ["user", "developer"]
targets   = ["README.md", "docs/cli.md", "docs/recipes/static-page.md", "docs/platforms.md", "docs/releasing.md", "site/README.md"]

[req.1]
title = "The site is a Rex app"
story = "As the maintainer, I want the site to be an ordinary Rex app on the DesignX standard so that building it tests the framework the way a user would."
ac_1  = "site/ is a workspace package whose pages, regions, parts, overlays and states follow the page folder convention; pnpm -C site check exits 0 with zero findings; the only dangerouslySetInnerHTML is through unsafeHtml() in the Prose part."
ac_2  = "Every page renders the sidecar (script type application/rex+json, id rex-page) and the data-rex-page attribute in its prerendered HTML; the hydrated pages expose the command palette listing every page; every control carries a data-rex address and the shell navigation carries data-rex-nav."
ac_3  = "The site uses the DesignX standard set from app/components/ui with a theme derived from the Rex mark, both color schemes, and no raw button, input, select, textarea, table or dialog in a region, part or overlay."

[req.2]
title = "Content from the sources, never copied"
story = "As a reader, I want the docs, errors, API, standards and changelog on the site to be what is in the repository so that the site never drifts from the code."
ac_1  = "Every doc under docs/ and docs/recipes/ (except the README files) is a page at /docs/<slug> or /docs/recipes/<slug> whose HTML is rendered from the markdown at build time with heading ids, a table of contents and relative links rewritten to site routes; the set of pages equals the set of files."
ac_2  = "Every REX code in the error catalog is a page at /errors/<code> showing code, area, message and hint, and /errors lists them grouped by area; the catalog is read from the package, not copied."
ac_3  = "Every file under docs/api is a page under /api; /standards shows every [standard.*] item of spec/rex-v02/spec.kvx with its status; /changelog renders CHANGELOG.md; the version on the home page is read from packages/rex/package.json."

[req.3]
title = "The home page sells Rex with true claims"
story = "As a developer landing on the site, I want to learn in one screen what Rex is, see proof that it works, and install it."
ac_1  = "The home page renders the hero with the mark, the tagline and subline from [design] copy, the four rules, the feature cards each linking a doc page, the install block with the version read at build time, and the footer with the repository, license and Sidiora Labs links."
ac_2  = "The LiveSidecar region shows the home page's own sidecar JSON, identical in the prerendered HTML and after hydration, with the copy button addressable through data-rex."
ac_3  = "Every number on the home page comes from the code at build time and a unit test asserts each against its source."

[req.4]
title = "A complete static deployment"
story = "As the maintainer, I want rex build --target static to produce a directory a static host serves completely so that the site needs no server."
ac_1  = "rex build --target static prerenders every page (ssg and static with paths, ssr and csr as the shell document), writes rex/manifest as a JSON file, index.md next to each prerendered page, 404.html, and dist/prerender.json; the tests in packages/rex cover each output and the demo builds with the target."
ac_2  = "Served by tools/serve-static.mjs, the built site makes no failed request on any page (asserted by the e2e walk with request failure tracking), the client reads the manifest inlined at build time, and a static page ships zero page JavaScript."
ac_3  = ".github/workflows/site.yml builds the package and the site, runs the gates and deploys dist/client to GitHub Pages on main with site/public/CNAME set to rex.sidioralabs.com; the deployment succeeds and the deployed site answers / with data-rex-page and the sidecar."

[req.5]
title = "The site passes the gates the demo passes"
story = "As the maintainer, I want the site held to the operability, accessibility, vitals and screen-fit gates so that it is proof, not a claim."
ac_1  = "The operability walk visits every page on phone, tablet and desktop, opens every popup trigger, reads every sidecar and invokes the addressable controls, and fails on a REX3xx region error, a page error, a console error or a failed request."
ac_2  = "The no-JS walk reads every static page with JavaScript disabled and finds the content, the navigation and the sidecar; axe reports zero violations; LCP, CLS and INP are within 2500 ms, 0.1 and 200 ms; Lighthouse reports performance 95, accessibility 100, best practices 95 and SEO 95 or higher; reports are committed under site/e2e/report."
ac_3  = "No page overflows horizontally on any project, every data-rex control is at least 44 px tall on phone, the navigation is a dock on phone and a sidebar on desktop, and every internal href in the built HTML resolves to a built file."

[req.6]
title = "The framework learns from the site"
story = "As the framework author, I want every gap the site exposes fixed in packages/rex so that the next Rex app does not meet it."
ac_1  = "Every gap met while building the site is an entry in spec/rex-site/qualification.kvx with the observation, and each is either fixed in packages/rex with a test or recorded as a [decision] here; task 3.3's report lists them."
ac_2  = "README.md links the site and docs/releasing.md describes the site deployment; the changelog is regenerated after the work lands."

[task.1.1]
title = "Scaffold the site package on the DesignX standard with the Rex theme, the shell, the gates skeleton and its workflow"
status = "done"
mode = "BUILD"
wave = 0
requires = []
reqs = ["1.1", "1.3", "4.3"]
do_1 = "Create site/ with the package's own rex new (run from packages/rex/dist after pnpm -C packages/rex build: rex new site --ui designx --no-install, then change the dependency to workspace:* and set name @sidioralabs/rex-site, private true, the scripts in [design] module_layout, the dependencies marked and shiki for the docs engine of task 2.2, and the dev dependencies the demo uses for vitest, Playwright, axe, lighthouse and web-vitals); add site to pnpm-workspace.yaml; pnpm install; keep the DesignX standard set and adapt theme-provider for both schemes."
do_2 = "Derive app/theme.css from the Rex mark per [decision] theme (look at assets/mark_rex_js.png and assets/light_mark_rex_js.png), copy the marks, favicon.png and og.png into site/public with CNAME rex.sidioralabs.com and robots.txt, write index.html with the meta tags, write app/components/Shell.tsx (DesignX sidebar on desktop, dock on phone, the navigation items from [design] pages, the GitHub link, the theme toggle) and app/components/Mark.tsx, and replace the generated home page with the home page folder declaring the regions of [design] pages as placeholders that render their heading (task 2.1 fills them)."
do_3 = "Write site/vitest.config.ts, site/playwright.config.ts with the phone (390 px, coarse pointer), tablet (820 px) and desktop (1440 px) projects and the webServer, tools/serve-static.mjs per [decision] hosting_gates with a unit test in tools (or packages/rex/src/cli if tools has no test runner) covering index resolution, 404.html and content types, site/e2e/walk.ts with the shared helpers copied from the demo's e2e and generalised to the site, site/README.md, and .github/workflows/site.yml with the verify job only (install, build the package, pnpm -C site check, pnpm -C site test:unit, pnpm -C site build); record every framework gap you meet in spec/rex-site/qualification.kvx."
touches = ["site", "pnpm-workspace.yaml", "pnpm-lock.yaml", "tools/serve-static.mjs", "tools/serve-static.test.mjs", ".github/workflows/site.yml"]
verify_cmd = "pnpm -C site check && pnpm -C site test:unit && pnpm -C site build"
gate_kind = "planned"
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 75
stop_condition = "Stop on the bounded gate result or time limit; record revision, command, exit code and log path. Do not mark done without the declared evidence."

[task.2.1]
title = "The home page: hero, the four rules, features, install, the live sidecar and the footer"
status = "pending"
mode = "BUILD"
wave = 1
requires = ["1.1"]
reqs = ["3.1", "3.2", "3.3", "1.2"]
do_1 = "Fill the home page regions per [design] copy and [design] live_sidecar with DesignX parts (card, badge, button, kbd, typography, separator, tooltip): Hero with the mark and the tagline, Pitch with the four rules, Primitives with the five declarations and the manifest, HowItWorks with the data-rex attribute table and the four invocation routes, Install with the InstallBlock reading the version through a read action, Features as cards linking their doc pages, LiveSidecar, Footer."
do_2 = "Read actions in app/actions/home for the version, the counts (error codes from the catalog, checker rules, the client budget) and the home sidecar; declare them in load; a test folder asserting every region renders, every number equals its source read directly in the test, the sidecar lists the copy action, and the prerendered LiveSidecar JSON equals the page sidecar; the site declares no i18n, so texts are plain English, and a checker finding on a text is a gap to record."
touches = ["site/app/pages/home", "site/app/actions/home", "site/app/server/content/meta.ts", "site/app/components/InstallBlock.tsx", "site/app/components/CodeBlock.tsx"]
verify_cmd = "pnpm -C site check && pnpm -C site exec vitest run app/pages/home"
gate_kind = "planned"
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 75
stop_condition = "Stop on the bounded gate result or time limit; record revision, command, exit code and log path. Do not mark done without the declared evidence."

[task.2.2]
title = "The docs engine and the doc, recipe and docs index pages with search"
status = "pending"
mode = "BUILD"
wave = 1
requires = ["1.1"]
reqs = ["2.1", "1.2"]
do_1 = "app/server/content/markdown.ts renders markdown with marked and shiki per [decision] markdown (heading ids, heading list, relative links between docs and recipes rewritten to /docs/<slug> and /docs/recipes/<slug>, links to repository files rewritten to the GitHub tree URL, code blocks highlighted server side with both color schemes through CSS variables); app/server/content/docs.ts lists and reads docs/*.md and docs/recipes/*.md (except README.md) with slug, title from the first heading, headings and the first paragraph; app/server/content/search.ts builds the index of [decision] search over docs, recipes and whatever the other readers expose through one function each reader exports."
do_2 = "Pages doc (/docs/:slug, static, paths from the reader, load the article) and recipe (/docs/recipes/:slug) with Article (the Prose part through unsafeHtml) and Toc regions; page docs (/docs, ssg) with the Index region listing guides and recipes by section and the Search region filtering the loaded index with the DesignX command item; the Prose part's typography from the DesignX typography item; tests asserting the page set equals the file set, a known doc renders its headings and rewritten links, the search index contains every doc, and the sidecar of each page."
do_3 = "marked and shiki are installed by task 1.1; the read actions live in app/actions/docs; record any framework gap in the qualification log (for example a route shape page() rejects, a checker rule on the Prose part, a loader shape)."
touches = ["site/app/pages/docs", "site/app/pages/doc", "site/app/pages/recipe", "site/app/server/content/markdown.ts", "site/app/server/content/docs.ts", "site/app/server/content/search.ts", "site/app/server/content/markdown.test.ts", "site/app/server/content/docs.test.ts", "site/app/actions/docs", "site/app/components/Prose.tsx", "site/app/components/Toc.tsx"]
verify_cmd = "pnpm -C site check && pnpm -C site exec vitest run app/pages/docs app/pages/doc app/pages/recipe app/server/content"
gate_kind = "planned"
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 90
stop_condition = "Stop on the bounded gate result or time limit; record revision, command, exit code and log path. Do not mark done without the declared evidence."

[task.2.3]
title = "The error catalog pages"
status = "implemented"
mode = "BUILD"
wave = 1
requires = ["1.1"]
reqs = ["2.2", "1.2"]
do_1 = "app/server/content/errors.ts reads the catalog from the package (REX_ERROR_DOCS and the codes of core/errors.ts through the entry that exports them; if no public entry exports the catalog, record the gap in the qualification log and read it through the package's check entry or a documented path, never by copying the catalog); each entry carries code, area with its title, message, hint and the docs URL the framework emits; the read actions live in app/actions/errors."
do_2 = "Page errors (/errors, ssg) with the Catalog region grouped by area and a filter on code or message text; page error (/errors/:code, static, paths from the catalog) with the Detail region (code as the heading, area badge, message, hint, a link to the area's doc page, previous and next code navigation); tests asserting every code is a path, a known code renders its message and hint, the docs URL of a RexError resolves to that page's route, and the sidecar of both pages."
touches = ["site/app/pages/errors", "site/app/pages/error", "site/app/server/content/errors.ts", "site/app/server/content/errors.test.ts"]
verify_cmd = "pnpm -C site check && pnpm -C site exec vitest run app/pages/errors app/pages/error app/server/content/errors.test.ts"
gate_kind = "planned"
max_builds = 1
max_verify_runs = 1
max_repair_cycles = 2
time_limit_minutes = 60
stop_condition = "Stop on the bounded gate result or time limit; record revision, command, exit code and log path. Do not mark done without the declared evidence."

[task.2.4]
title = "The standards, changelog and about pages"
status = "pending"
mode = "BUILD"
wave = 1
requires = ["1.1"]
reqs = ["2.3", "1.2"]
do_1 = "app/server/content/standards.ts parses spec/rex-v02/spec.kvx [standard.*] sections and the [task.*] statuses they map to; app/server/content/changelog.ts reads CHANGELOG.md and splits it into releases; page standards (/standards, static) with the Table region (DesignX table on desktop, card list on phone, one row per item with its status badge and owning tasks); page changelog (/changelog, static) with the Releases region rendered through the Prose part; page about (/about, static) with the Sidiora, License, Governance, Contributing and Security regions linking the repository files; the read actions live in app/actions/standards and app/actions/changelog."
do_2 = "Tests asserting every [standard.*] item is a row, the statuses equal the spec, every release heading of CHANGELOG.md is rendered, the about links resolve to files that exist in the repository, and the sidecar of each page."
touches = ["site/app/pages/standards", "site/app/pages/changelog", "site/app/pages/about", "site/app/server/content/standards.ts", "site/app/server/content/changelog.ts", "site/app/server/content/standards.test.ts", "site/app/server/content/changelog.test.ts", "site/app/actions/standards", "site/app/actions/changelog"]
verify_cmd = "pnpm -C site check && pnpm -C site exec vitest run app/pages/standards app/pages/changelog app/pages/about app/server/content/standards.test.ts app/server/content/changelog.test.ts"
gate_kind = "planned"
