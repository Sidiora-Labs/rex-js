# rex-site qualification log. One six-line entry per unrelated failure, contradiction or framework gap.

[qualification.111]
task = "1.1"
file = "packages/rex/src/cli/designx.ts, packages/rex/src/cli/gen/designx.ts"
symbol = "designxFiles THEME_PRELUDE, the rex new --ui designx app/theme.css"
observed = "rex new site --ui designx writes app/theme.css from the DesignX theme item alone: it styles the DesignX primitives but nothing Rex renders itself (.rex-page-header, .rex-page-title, .rex-outcome, [data-rex-palette] with its cmdk input, list and items, [data-rex-overlay], [data-rex-confirm], form[data-rex-form] fields and submit), so a new app's command palette, confirmation and outcome render unstyled and the palette items fall under 44 px on touch; the demo carries these rules by hand in examples/demo/app/theme.css and the site copies them; evidence: revision 4967803, command node packages/rex/dist/cli/index.js new site --ui designx --no-install, the written site/app/theme.css."
assumption = "Task 3.3 makes rex new (and rex designx add of the theme) append the Rex surfaces layer to the DesignX theme so every DesignX app styles the palette, overlays, confirmation, outcome and ActionForm, and the site and the demo drop their copies."
severity = "medium"

[qualification.112]
task = "1.1"
file = "packages/rex/src/server/ssr.ts, packages/rex/src/vite/ssr-css.ts, packages/rex/src/cli/commands/build.ts"
symbol = "documentHead, readSsrAssets, RexDocumentAssets.head"
observed = "The prerendered and server-rendered document head is built by documentHead from charset, viewport, the page title, font and image preloads, stylesheets and module preloads only; the head of the app's index.html (meta description, rel=canonical, Open Graph, twitter card, theme-color, rel=icon) reaches the document only in dev through devAssets(head), and the production assets from readSsrAssets carry no head, so every prerendered site page ships without the meta tags site/index.html declares, and there is no per-page way to set a canonical URL or description, which Lighthouse SEO reads; evidence: revision 4967803, read from packages/rex/src/server/ssr.ts documentHead and packages/rex/src/vite/ssr.ts devAssets."
assumption = "Task 3.3 carries the non-script head of index.html into the production document head (and gives a page a way to declare its canonical path and description, for example chrome.description and a site origin in the config) so the site's prerendered pages keep their meta tags; until then the site's meta tags apply to the shell document only."
severity = "high"

[qualification.113]
task = "1.1"
file = "packages/rex/src/vite/plugin.ts, packages/rex/src/vite/shell-components.ts, packages/rex/src/testing/index.ts"
symbol = "rex() plugin options in vitest.config.ts, RexPluginOptions.shellComponents"
observed = "rex check, rex build and rex dev read ui.components from rex.config.ts through configPluginOptions, but a vitest.config.ts calls rex() with no options and nothing reads the config there, so renderPage renders the token shell instead of the app's Shell.tsx and a site test cannot assert its own frame, mark, navigation forms or theme toggle; the demo's tests have the same blind spot; the site passes rex({ shellComponents: \"app/components/Shell.tsx\" }) by hand, a second statement of ui.components; evidence: revision 4967803 plus the 1.1 changes, command pnpm -C site check && pnpm -C site test:unit && pnpm -C site build, exit 1, log /tmp/claude-0/-root-rex-js/515dae63-ecbb-496d-92f1-ca9ddb32fa48/scratchpad/w-rex-site-1.1-private/logs/1.1-verify.log (home.test.tsx found no [data-site-mark] in the token frame)."
assumption = "Task 3.3 makes rex() read rex.config.ts when it runs under vitest (or exports a rexTestPlugins() helper from rex/vite that does) so the app's shell components, fonts and ui options reach unit tests without restating them, and the site drops its explicit shellComponents option."
severity = "medium"
