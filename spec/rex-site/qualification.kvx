# rex-site qualification log. One six-line entry per unrelated failure, contradiction or framework gap.

[qualification.251]
task = "2.5"
file = "packages/rex/src/client/loaders.ts, packages/rex/src/client/router.tsx, packages/rex/src/client/form.tsx"
symbol = "client navigation, loader refetch and ActionForm posts of a static build without client.apiOrigin"
observed = "2.5 makes rex build --target static write every page, index.md, rex/manifest and 404.html and removes the manifest request from the static client (no /rex/manifest in any client chunk), but a client-side navigation from a hydrated ssg page to a page with loaders runs the loaders through POST /rex/rpc, a stale loader query refetches on window focus through the same route, and an ActionForm posts to /rex/form/<action>; none of these routes exists on a static host, which [decision] static_target forbids; evidence: revision 4967803 plus the 2.5 changes, read from loaderQueryOptions (refetchOnMount only guards server-seeded data) and the wouter navigation in the shell."
assumption = "Task 3.3 makes a static build navigate to prerendered paths with a document load (or reads the dehydrated data of the target page) and disables loader refetch when no apiOrigin is configured, so the site's walk records no failed request; the site has no actions, so no form posts."
severity = "high"

[qualification.252]
task = "2.5"
