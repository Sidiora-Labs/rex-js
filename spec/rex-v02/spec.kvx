s2 = "One standard component vocabulary (DesignX) across generated apps, the shell and the demo, enforced by the checker."
s2_now = "partial: rex new installs a DesignX base set and the demo overrides four shell slots; demo regions and parts use plain elements; no rule"
s2_tasks = ["9.2", "9.3", "9.4"]

