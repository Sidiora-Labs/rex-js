[task.9.6]
title = "The demo walks green end to end: no-JS forms visible without JavaScript, the sidecar mirror and hydration in step with the server, portfolio contrast, INP on SSR pages and the demo unit tests"
status = "implemented"
mode = "BUILD"
wave = 9
requires = ["9.5", "7.19", "7.21"]
