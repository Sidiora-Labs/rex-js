[task.9.1]
title = "Screen classification, fluid tokens, container-driven layout and screen-aware overlays in the runtime"
status = "implemented"
mode = "BUILD"
wave = 9
requires = ["7.9", "7.11", "7.15"]
reqs = ["37.1", "37.2", "37.3"]
do_1 = "client/screen.ts classifies the screen (phone under 600 px, tablet under 1024, desktop under 1600, wide), the pointer (matchMedia pointer: coarse) and the density (comfortable by default, compact when the app or the user asks, agent when the agent density is requested) and keeps data-rex-screen, data-rex-pointer and data-rex-density current on the document root through matchMedia and ResizeObserver; useScreen() exposes them and the sidecar carries screen, pointer and density; server/ssr.ts writes the initial root attributes from Sec-CH-UA-Mobile and Sec-CH-Viewport-Width with a user-agent fallback and sends Accept-CH, and the node, bun, deno and edge adapters pass those headers through."
do_2 = "client/tokens.css becomes fluid: --rex-text-1 to --rex-text-6 and --rex-space-1 to --rex-space-8 are clamp() ranges keyed by data-rex-screen and scaled by data-rex-density, controls get min-block-size and min-inline-size 44px under data-rex-pointer coarse (density.css keeps its agent rules), and client/layout.tsx makes Page.Grid a container (container-type inline-size) whose columns collapse at container widths rather than viewport widths and Page.Stack spacing follow the density scale; no component declares a pixel width."
do_3 = "Overlays and navigation choose their form by screen: the overlay host renders the shell Sheet slot with a form prop (dialog on desktop and tablet, bottom-sheet on phone) and the default token-styled Sheet honours it, the Nav slot from 9.0 takes its form from the screen (sidebar on desktop, dock on phone) and the derived shell renders it from the manifest's pages, and both keep their data-rex addresses, declared dismissal and sidecar entries on every screen; client/screen.test.tsx, layout.test.tsx, the overlay and shell tests and server/ssr.test.tsx prove each claim against happy-dom with matchMedia stubs that are part of the test, and docs/agent-contract.md documents the new sidecar fields."
touches = ["packages/rex/src/client/screen.ts", "packages/rex/src/client/screen.test.tsx", "packages/rex/src/client/tokens.css", "packages/rex/src/client/agent/density.css", "packages/rex/src/client/agent/density.ts", "packages/rex/src/client/agent/sidecar.tsx", "packages/rex/src/client/layout.test.tsx", "packages/rex/src/client/shell", "packages/rex/src/client/shell.tsx", "packages/rex/src/client/shell.test.tsx", "packages/rex/src/client/overlay.tsx", "packages/rex/src/client/overlay.test.tsx", "packages/rex/src/server/ssr.ts", "packages/rex/src/server/ssr.test.tsx", "packages/rex/src/server/adapters", "packages/rex/src/manifest/sidecar.schema.ts", "packages/rex/src/manifest/types.ts", "docs/agent-contract.md"]
