[documentation]
mode      = "auto"
status    = "pending"
audiences = ["user", "developer"]
targets   = ["README.md", "docs/**", "CONTRIBUTING.md", "CHANGELOG.md", "GOVERNANCE.md", "SECURITY.md", "MAINTAINERS.md", "CODE_OF_CONDUCT.md"]

[req.1]
title = "Modular entry points"
story = "As a fleet of agents working in parallel, I want the plugin, server and client entry points split by concern so that tasks touch disjoint files."
ac_1  = "packages/rex/src/vite/plugin.ts assembles the Vite plugin from the ordered hook list in vite/hooks.ts; app-module.ts, entry-module.ts, resolve.ts and scan.ts each own one concern; vite/index.ts only re-exports; every existing vite test passes unchanged."
ac_2  = "packages/rex/src/server/app.ts composes createRexServer from server/routes.ts and server/middleware.ts ordered lists; routes/manifest.ts, rpc.ts and health.ts own the existing routes; server/index.ts re-exports and imports nothing from node:; every existing server test passes unchanged."
ac_3  = "packages/rex/src/client/entry.tsx builds createRexEntry from the client/providers.ts list and client/shell.tsx composes the Shell from the slot components registered in client/shell/slots.ts; every existing client test passes unchanged."

[req.2]
title = "Configuration and declaration options for 0.2"
story = "As an app author, I want one validated config file and page options for the new capabilities so that every feature is declared, not wired."
ac_1  = "rex/config exports defineConfig and the RexConfig type described in [design] config_schema; an invalid config throws a RexError with a REX1xx code naming the field."
ac_2  = "page() accepts render, revalidate, paths, load, cache, transition and chrome.components as described in [design] page_options, validates them (revalidate only with ssg, paths only with ssg and route params, load values are read actions) and records them on the declaration and in the manifest."
ac_3  = "action() accepts form and jsonSchema as described in [design] action_options and records them in the manifest."
ac_4  = "rex dev, rex build, rex check and rex manifest read rex.config.ts through defineConfig; a bare Hono app default export still works and emits deprecation REX101 once."

[req.3]
title = "Standard Schema core"
story = "As an app author, I want to bring any Standard Schema library and keep the core small so that the schema choice is mine and the bundle stays within budget."
ac_1  = "entity(), action() and page() accept any object implementing the Standard Schema v1 interface for fields, input, output and params; validation in the runtime, the router and useAct goes through ~standard.validate."
ac_2  = "The Rex field helpers (id, text, money, boolean, enumOf, ref, json, integer, real) are built on zod/mini and keep their x-rex-field tags; the demo and rex new templates use zod/mini."
ac_3  = "JSON Schema is produced only in buildManifest: through z.toJSONSchema for zod schemas, from a declared jsonSchema for others, and a REX210 error names the declaration when neither is possible."
ac_4  = "A size test proves the rex entry bundled for the browser in production mode, with React and zod external and no zod module reachable from the entry, is at most 15 KB gzipped; the client and edge entries meet 30 KB and 40 KB under the same rule."

[req.4]
title = "Package hygiene"
story = "As an adopter, I want few, honest dependencies and a clean package so that installs are small and auditable."
ac_1  = "packages/rex/package.json lists as dependencies only hono, @orpc/server, @orpc/client and @orpc/tanstack-query; react, react-dom, @tanstack/react-query, vite, zod and typescript are peerDependencies; drizzle-orm, @libsql/client, @hono/node-server, cmdk, wouter, @opentelemetry/api, @vitejs/plugin-react, babel-plugin-react-compiler and @tailwindcss/vite are optional peers declared in peerDependenciesMeta; tsx and commander are removed."
ac_2  = "license is MIT with a LICENSE file at the repository root; sideEffects lists only CSS files; every export has a types condition first; files publishes dist only; publishConfig sets provenance true."
ac_3  = "Exports include ./config, ./testing, ./server/node, ./server/bun, ./server/deno, ./server/edge, ./store/drizzle, ./devtools and ./eslint, each resolving in the built package; a pack test runs npm pack --dry-run and asserts every export and its types are in the tarball."
ac_4  = "The CLI parses its own arguments without commander and loads rex.config.ts and app code through Vite's module runner without tsx."

[req.5]
title = "Code splitting and boundaries"
story = "As a user, I want each page to load only its own code and to recover from a region crash so that pages are fast and resilient."
ac_1  = "rex:app imports each page's view, states, regions and overlays through dynamic import; rex build emits one chunk per page and the chunk table names them."
ac_2  = "PageHost renders page modules under Suspense with the page's loading state as fallback; a slow module shows the loading state and never a blank screen."
ac_3  = "Each Region is wrapped in an error boundary; a throwing region renders the page's recoverable-error state scoped to that region with a retry that remounts it, and the sidecar reports the state and the error code."
ac_4  = "rex build prints name, raw and gzip sizes and the budget for every chunk and exits 1 when a page chunk exceeds its budget."

[req.6]
title = "React Compiler"
story = "As a developer, I want automatic memoisation so that changing one value re-renders only what reads it."
ac_1  = "The Vite plugin enables babel-plugin-react-compiler through @vitejs/plugin-react when config.compiler is not false; the compiled output is verified by a test that checks the React Compiler runtime import appears in a built part."
ac_2  = "A Profiler-based test renders the fixture page, updates one store value read by one part, and asserts that only that part's commit count increases."

[req.7]
title = "Size budgets"
story = "As a maintainer, I want budgets enforced by tests and builds so that the runtime cannot grow unnoticed."
ac_1  = "A size test bundles the rex, rex/client and rex/server/edge entries with Vite's build API and asserts the budgets in [design] budgets."
ac_2  = "rex.config budgets override page and client budgets; rex build applies them to the app's chunks."

[req.8]
title = "Streaming SSR"
story = "As a user on a slow network, I want pages to render on the server and stream so that content appears before JavaScript."
ac_1  = "A GET on a page route with render ssr returns HTML streamed from renderToReadableStream containing the shell, the page content with its data-rex attributes, the sidecar script, the dehydrated loader data script and the CSS links for the entry and the page chunk in the head."
ac_2  = "The client hydrates with hydrateRoot when data-rex-ssr is present and the hydrated page is interactive: a click on an action control invokes it; no hydration mismatch is logged in the test."
ac_3  = "A page with render csr returns the shell with the page loading state and hydrates the page on the client."
ac_4  = "Policy denial, unknown routes and loader failures during SSR render the matching data state server-side with the correct HTTP status (403, 404, 500)."
ac_5  = "The SSR HTML has no flash of unstyled content: stylesheet links precede the first body content, verified by the walk reading the response order."

[req.9]
title = "Loaders"
story = "As an app author, I want data declared on the page and loaded once, server or client, with caching and deduping, so that no hook fetches by hand."
ac_1  = "page.load maps names to read actions, optionally with an input function of the params; the manifest lists each loader."
ac_2  = "During SSR loaders run in process and their results are dehydrated into the HTML; on the client they hydrate the QueryClient so the first render has data without a request."
ac_3  = "useLoader(page, name) returns the TanStack query with the inferred output type; concurrent uses dedupe to one request; cache.staleTime is honoured."
ac_4  = "A mutating action that declares invalidates refetches the affected loaders; a loader failure maps to the page's recoverable-error or terminal-error state by the existing precedence."

[req.10]
title = "SSG, regeneration and static pages"
story = "As an operator, I want pages prerendered at build with on-demand regeneration and the option of zero JavaScript so that static content is cheap and fast."
ac_1  = "rex build prerenders every page with render ssg or static to dist/client/<route>/index.html, expanding paths for dynamic routes, and lists them in the build output."
ac_2  = "The node adapter serves prerendered pages; with revalidate set, a request after the window serves the cached page and regenerates in the background, and the next request gets the new HTML."
ac_3  = "A static page's HTML contains no page chunk script and no hydration script; its actions render as forms and work through the form route; the sidecar is present as static JSON."
ac_4  = "The checker reports a static page that declares an action with a shortcut or an overlay bound to region state, because those need JavaScript (rule render/static-needs-js)."

[req.11]
title = "Progressive enhancement forms"
story = "As a user without JavaScript, I want every action to work as a form so that the app degrades gracefully."
ac_1  = "ActionForm renders a form posting to /rex/form/<action> with hidden _csrf and action fields and inputs for the action's input schema; a submit with JavaScript enabled is intercepted and run through useAct with the same outcome handling."
ac_2  = "POST /rex/form/<action> coerces FormData with the input schema, checks CSRF and Origin, evaluates policy, runs the action, writes the outcome cookie and redirects; the outcome region shows the cookie outcome on the next render and clears it."
ac_3  = "An irreversible action posted without _confirm returns a server-rendered confirmation page listing the input with a Confirm form; posting it with _confirm runs the action."
ac_4  = "Validation failures redirect back with the field errors in the outcome cookie and ActionForm renders them next to the fields."
ac_5  = "The walk runs the send flow with JavaScript disabled in Playwright and asserts the audit record."

[req.12]
title = "Runtime adapters"
story = "As an operator, I want to deploy to Node, Bun, Deno or an edge runtime so that hosting is my choice."
ac_1  = "rex/server imports nothing from node:; a test bundles it for the browser platform and asserts no node builtins are referenced."
ac_2  = "rex/server/node, rex/server/bun, rex/server/deno and rex/server/edge export serve or a fetch handler per [design] runtimes; the node adapter passes the existing node tests; the bun and deno adapters throw REX450 with the runtime name when their global is absent and otherwise hand the fetch handler to Bun.serve or Deno.serve; the edge adapter exports the Hono fetch handler and a test runs it against Request objects with no node globals."
ac_3  = "rex build --target node|edge|bun|deno|static writes the matching server entry and dist layout documented in docs/platforms.md; the static target bakes client.apiOrigin into the entry."

[req.13]
title = "Errors that point at source"
story = "As an agent fixing a build, I want every error to carry a code, location and hint so that the fix is mechanical."
ac_1  = "RexError carries code, hint, docs, and file, line and column when known; every throw in core, server, client, vite, check and cli uses a catalogued code from core/errors.ts."
ac_2  = "Declaration errors raised while loading app modules in the Vite plugin surface in the Vite error overlay with the declaring file and line; CLI commands print a source frame for errors with a location."
ac_3  = "docs/errors.md is generated from the catalog by rex docs:errors (an internal script) and the docs test fails when stale."

[req.14]
title = "Hot module replacement"
story = "As a developer, I want edits to parts and regions to keep component state so that iteration is fast."
ac_1  = "A test starts the Vite dev server on the fixture app, edits a part file and observes an HMR update (not a full reload) for that module through the server's HMR channel."
ac_2  = "Editing page.ts invalidates rex:app and the page chunk and triggers a full reload with a REX320 notice naming the page."

[req.15]
title = "Devtools"
story = "As a developer, I want an in-app devtools overlay so that I can inspect the manifest, state, sidecar, outcomes, queries, renders and audit without leaving the page."
ac_1  = "RexDevtools mounts only in dev mode and when config.devtools is not false; shift+mod+d toggles it; it is absent from production bundles (verified by a build test)."
ac_2  = "Panels show the manifest, the current page's params, state and loaders, the live sidecar JSON, the outcome log, the QueryClient cache, per-region render durations from Profiler, and the audit tail from GET /rex/dev/audit which exists only in dev mode."

[req.16]
title = "Testing helpers"
story = "As an app author, I want first-party test helpers so that pages and regions are tested against the real runtime."
ac_1  = "rex/testing exports createTestApp, renderPage, renderRegion, testServer and readSidecar as described in [design] testing_api, each backed by the real server and runtime."
ac_2  = "The demo's page test folders contain tests written with rex/testing for every page and region, run by pnpm -C examples/demo test:unit."

[req.17]
title = "Lint and format presets"
story = "As a team, I want editor-time feedback matching the checker so that violations are seen before rex check."
ac_1  = "rex/eslint exports a flat config that runs the checker's boundary, naming, trap, token, a11y and media rules per file through an ESLint plugin plus eslint-plugin-jsx-a11y recommended rules; rex/prettier exports the format preset."
ac_2  = "rex new writes eslint.config.js and .prettierrc using the presets and adds lint and format scripts; rex check runs the formatter in check mode as rule format/prettier."

[req.18]
title = "Real documentation"
story = "As a newcomer, I want a tutorial, recipes, an API reference and a migration guide so that I can learn Rex in a day."
ac_1  = "docs/tutorial.md builds the wallet demo from rex new step by step with every command and file; docs/recipes/ holds at least eight recipes (loader, form without JS, overlay, flow approval, static page, i18n, web component, incremental adoption); docs/migration.md covers adopting Rex inside an existing Vite or Next app and upgrading 0.1 to 0.2; docs/versioning.md states the semver, deprecation and codemod policy."
ac_2  = "docs/api/ is generated by typedoc from the package entries by pnpm docs:api and committed; a test fails when it is stale."
ac_3  = "A link check over docs/ and README.md passes."

[req.19]
title = "Shared state"
story = "As an app author, I want a shared state primitive that agents can see so that cross-region state needs no third-party library."
ac_1  = "store() returns a typed store with get, set, update, subscribe and useStore built on useSyncExternalStore; stores declared with expose true appear in the sidecar under state.stores and update it on change."
ac_2  = "Stores reset between tests through rex/testing and serialise to JSON for the devtools panel."

[req.20]
title = "Web Components, native DOM and incremental adoption"
story = "As a team with an existing app, I want to adopt Rex one widget or page at a time and to use custom elements so that migration is gradual."
ac_1  = "defineElement registers a custom element rendering a part with attributes mapped to props; mountRexPage mounts a page with its providers into a foreign DOM node and returns unmount; Native exposes the DOM node by ref."
ac_2  = "A test mounts a Rex page inside a plain HTML document with other content, invokes an action through the sidecar address, and unmounts cleanly."
ac_3  = "The checker allows custom element tags in parts when they carry tabindex or a declared keyboard equivalent and reports them otherwise (rule traps/custom-element)."

[req.21]
title = "Navigation, focus and announcements"
story = "As a screen reader user, I want route changes announced and focus placed sensibly, with smooth transitions when supported."
ac_1  = "After a route change focus moves to the page heading or main landmark and the announcer live region in the Shell contains the page title."
ac_2  = "With transition view and document.startViewTransition present, route changes run inside a view transition; with window.navigation present, same-origin navigate events are intercepted and routed through RexRoutes; both verified with injected globals of the real shape."

[req.22]
title = "Accessibility rules and audit"
story = "As a team, I want accessibility mistakes caught by the checker and the walk so that every release is accessible."
ac_1  = "The checker reports the rules listed in [design] a11y_rules with file, line, message and hint, each with a passing and failing fixture."
ac_2  = "The walk runs axe-core on every page in both densities and fails on serious or critical violations; the demo passes."

[req.23]
title = "Internationalisation"
story = "As a product in several markets, I want messages per locale and locale-aware routing so that the UI and the sidecar speak the user's language."
ac_1  = "app/locales/<locale>.json messages resolve through useT, t and msg: keys in labels, titles and outcomes, including in the sidecar and palette; placeholders and plural forms work through Intl."
ac_2  = "With i18n.routing prefix every page mounts under /:locale, nav.to keeps the locale, the locale resolves from the prefix, then the rex-locale cookie, then Accept-Language, then the default; the html lang attribute is set."
ac_3  = "The checker reports a label or title literal when i18n is configured and the literal is not a msg: key (rule i18n/literal), with an allow list."

[req.24]
title = "Styling freedom"
story = "As a designer, I want to use tokens, CSS Modules, Tailwind or CSS-in-JS without fighting the checker so that styling is my choice."
ac_1  = "CSS Modules and Tailwind 4 through @tailwindcss/vite work in a Rex app; a fixture using both passes rex check."
ac_2  = "The token rule only reports raw color and spacing literals and resolves Tailwind utilities to tokens through the theme; its allow lists are configurable in rex.config."

[req.25]
title = "Security"
story = "As an operator, I want XSS, CSRF and bundle leaks prevented by default so that deployments are safe without a checklist."
ac_1  = "unsafeHtml(html) is the only sanctioned way to render raw HTML; the checker reports dangerouslySetInnerHTML elsewhere (rule security/unsafe-html); every inline serialisation Rex emits escapes <, >, & and line separators."
ac_2  = "POST requests to /rex/* are rejected with 403 when Origin is absent or not allowed; form posts also require the CSRF cookie match."
ac_3  = "A per-request nonce is applied to every inline script Rex emits in SSR and dev; Content-Security-Policy and the companion headers are set from security config and strict by default; the walk asserts no CSP violation is reported in the browser console."
ac_4  = "Action handlers are stripped from the client bundle; a client import of rex/server, app/server or a rex/server-only module fails the build with REX440; rex build fails with REX441 when the client output references process.env without the VITE_ prefix or any configured secret name."

[req.26]
title = "Observability"
story = "As an operator, I want traces and logs from Rex so that agent and user activity is observable in my existing tooling."
ac_1  = "createRexServer accepts telemetry.tracer and telemetry.logger; spans are emitted per [design] telemetry_impl and verified with the OpenTelemetry in-memory span exporter; audit records carry traceId and spanId."
ac_2  = "The client exposes onOutcome and onNavigate hooks on createRexApp options and the devtools Outcomes panel uses them."

[req.27]
title = "Supply chain and release engineering"
story = "As a consumer, I want CI, audits and provenance so that the package is trustworthy."
ac_1  = ".github/workflows/ci.yml runs install, typecheck, test, check, walk, vitals, pnpm audit and license review on push and pull request; release.yml publishes on a v* tag with npm provenance and OIDC."
ac_2  = "tools/gate-lint.sh runs pnpm audit --prod and the license review script; both pass on the current lockfile."

[req.28]
title = "Images, fonts and scripts"
story = "As a user, I want images, fonts and third-party scripts loaded well without manual tuning."
ac_1  = "Img, Script and the fonts config behave as in [design] media_api; the checker rule media/no-raw-img reports raw img elements in parts and regions."
ac_2  = "SSR emits preload links for priority images and configured fonts and the font-face block with font-display swap."

[req.29]
title = "DesignX UI integration"
story = "As a Sidiora app, I want DesignX components installed and used by default so that generated UI is on-system."
ac_1  = "rex new --ui designx (default) fetches the DesignX theme and the base set (button, card, field, input, select, sheet, dialog, skeleton, empty, command, table, tabs, tooltip, kbd, badge) from the registry into app/components/ui and app/theme.css, installs their dependencies and Tailwind 4, and the generated app passes rex check; --ui none keeps the token components."
ac_2  = "The demo uses DesignX components for every part and overlay; agent density still disables motion and the walk and axe pass."
ac_3  = "chrome.components lets an app replace the shell's Button, Sheet, Palette item and Outcome renderers with DesignX ones; the demo does."

[req.30]
title = "Cross-platform output and the text renderer"
story = "As a product team, I want a path to desktop, mobile and terminal agents so that one app serves every surface."
ac_1  = "client.apiOrigin makes the static client talk to a remote server with CORS for security.origins; docs/platforms.md documents Electron, Tauri and Capacitor with the build targets."
ac_2  = "GET /rex/pages/<id>.md renders the page per [design] text_renderer and the walk asserts it lists every sidecar action."

[req.31]
title = "Versioning, deprecations and codemods"
story = "As an upgrader, I want deprecations announced once and codemods to apply them so that breaking changes are cheap."
ac_1  = "deprecated(code, message) warns once per code with the docs link; rex migrate lists and applies the codemods in [design] migrate idempotently and reports changed files."
ac_2  = "A 0.1 fixture app migrated by rex migrate passes rex check and the runtime test."

[req.32]
title = "Governance"
story = "As a contributor, I want governance, maintainers, security policy and conduct documented so that the project outlives any one person."
ac_1  = "GOVERNANCE.md, MAINTAINERS.md, SECURITY.md, CODE_OF_CONDUCT.md and .github/FUNDING.yml exist with real content and are linked from README."

[req.33]
title = "Remaining 0.1 gaps"
story = "As the Rex team, I want the known gaps from 0.1 closed so that the README has none."
ac_1  = "Page.List renders a paged list with page and size URL params and a load-more control that appends; the demo holdings use it; the checker rule traps/infinite-list reports scroll-loading lists without it."
ac_2  = "Flow decisions write audit records with the gate id and decision."
ac_3  = "rex check --runtime mounts every page in happy-dom per actor and state and reports sidecar actions without a visible control and controls without a sidecar entry (rule parity/runtime)."

[req.34]
title = "Core Web Vitals and Lighthouse gate"
story = "As a release engineer, I want vitals measured on every release so that performance is a tested property."
ac_1  = "examples/demo/e2e/vitals.spec.ts measures LCP, CLS and INP on every page with the web-vitals library and fails above 2500 ms, 0.1 and 200 ms; reports are written to e2e/report."
ac_2  = "examples/demo/e2e/lighthouse.ts runs Lighthouse against every page and fails under performance 90 or accessibility 95; reports are written to e2e/report."

[req.35]
title = "Demo and release 0.2.0"
story = "As the Rex team, I want the demo to exercise every 0.2 capability and the package to be releasable."
ac_1  = "The demo adds a static About page, an ssg Tokens page with revalidate, a loader-driven portfolio, forms on send, a shared store, Img and fonts, a locale switch with two locales, and a web-component embed example; the walk, the no-JS walk, axe and vitals pass with zero failures."
ac_2  = "package version is 0.2.0, CHANGELOG has the 0.2.0 entry, README carries the standards table with no open gap, docs are regenerated, and the pack test passes."

[req.36]
title = "Continuous integration, coverage and the published package"
ac_1  = "Every push and pull request runs typecheck, the unit tests with coverage, the size budgets, the demo check with its unit, operability, no-JS, axe and vitals walks, the docs link and API checks, the audit and license review, the lint and format check and the package smoke test; a v<version> tag publishes @sidioralabs/rex to npm with provenance after the same gates."
ac_2  = "The unit suite covers at least 90 percent of lines, statements and functions and 80 percent of branches of packages/rex/src, and the repository holds at least one line of test code for every line of source code; both are measured by scripts the CI pipeline runs and are never lowered to pass."
ac_3  = "The packed tarball installs into a fresh rex new app, which builds, serves its home page, its manifest and an RPC call from the built server, and the tarball passes publint and are-the-types-wrong; the README documents installation from npm."
ac_4  = "The repository is linted and formatted by its own rex/eslint and rex/prettier presets with zero findings, checked in CI."

[req.37]
title = "Screen-fit sizing"
ac_1  = "The document root carries data-rex-screen (phone, tablet, desktop, wide), data-rex-pointer (coarse, fine) and data-rex-density (comfortable, compact, agent) from the first server response (Client Hints with a user-agent fallback, Accept-CH sent) and the client keeps them current on resize and pointer change; useScreen() returns the three values and the sidecar carries them."
ac_2  = "The token sheet defines fluid type and space scales with clamp() keyed by screen class and density; Page.Grid collapses its columns by the width of its container, not the viewport, and Page.Stack spacing scales with the density; every interactive control meets a 44 px minimum target on coarse pointers."
ac_3  = "An overlay renders as a dialog on desktop and as a bottom sheet on phone, navigation renders as a sidebar on desktop and a dock on phone, and both stay operable through the same data-rex addresses and sidecar entries on every screen."
ac_4  = "The demo walk runs on phone, tablet and desktop viewports with no horizontal overflow, targets of at least 44 px on the phone project, axe clean and the vitals thresholds met on each."

[req.38]
title = "DesignX as the standard vocabulary"
ac_1  = "rex/designx exports the surface-to-registry map and the standard set; rex new --ui designx installs the standard set from the registry and generates the shell override, the states and the first regions on those primitives; the demo uses the primitives in every region, part, overlay and state."
ac_2  = "The checker reports ui/designx-primitive for a raw button, input, select, textarea, table or dialog element in a region, part or overlay of an app whose ui.kit is designx, layout/fixed-size for pixel widths and heights on parts, and layout/touch-target for controls declared under 44 px, each with a fix hint naming the primitive or token to use."
ac_3  = "docs/convention.md and docs/recipes document the screen-fit contract and the DesignX map, and the agent contract documents the screen, pointer and density fields of the sidecar."

[req.39]
title = "Freshness: the README, manifests, docs, templates and community files match the code"
story = "As a maintainer, I want every statement in the README, the package manifests, the docs and the community files to match the code and the spec decisions, and a gate that fails when they drift, so that nothing the project publishes about itself is stale."
ac_1  = "Every entry in spec/rex-v02/freshness.kvx is closed: the stale statement is replaced by the recorded fix (or a better one proven against the code), and a re-run of the same audit over the merged tree reports no confirmed entry."
ac_2  = "tools/freshness.mjs --check (run by the demo test script, the CI docs job and src/freshness.test.ts) fails when a package export has no reference section or API page, when a CLI command or flag differs between the CLI and README.md or docs/cli.md, when the Node floor, the rex version in templates or the CHANGELOG head disagree with package.json, when docs/errors.md, docs/api or a generated pointer file is stale, or when a relative link is broken."
ac_3  = "npm shows a package README and LICENSE for @sidioralabs/rex, package.json carries repository, homepage and bugs, and the CHANGELOG has the 0.2.0 entry that the release task finalises."

