# rex-v02 — Rex 0.2: production standard. Closes every gap against the framework
# standards list in [standard.*]. Format: sectioned KV (.kvx); strings double-quoted.

[meta]
feature    = "rex-v02"
name       = "Rex 0.2: production standard"
slug       = "rex-v02"
version    = "0.2.0"
status     = "draft"
intro      = "Rex 0.1 proved the convention and the agent contract. Rex 0.2 brings the framework to the standard a production web framework is held to: small budgeted runtime, per-route rendering modes with streaming SSR, loaders and progressive forms, boundaries and code splitting, edge runtimes, errors that point at source, devtools, testing helpers, accessibility and i18n, security by default, observability, DesignX UI, codemods, governance and a measured Core Web Vitals gate."
goal       = "Ship @sidioralabs/rex 0.2.0 with every [standard.*] item either met and verified or deliberately scoped with an owning task, and the demo passing the extended operability walk, the vitals gate and the checker with zero findings."
scope      = "Package hygiene and budgets, Standard Schema core, rendering modes, loaders, forms, runtime adapters, compiler, splitting and boundaries, DX (errors, HMR, devtools, testing, lint, docs), state and interop, navigation and accessibility, i18n, styling freedom, security, telemetry, supply chain and governance, images and fonts, cross-platform output, versioning and codemods, DesignX integration, the remaining 0.1 gaps, vitals verification and the 0.2.0 release."
completion = "All acceptance criteria pass; rex check, the operability walk, the no-JS walk, the axe pass and the vitals gate exit zero on the demo; the standards table in README reports no open gap; 0.2.0 is tagged and packable with provenance configuration."

[decision]
baseline         = "Everything in 0.1 stays: the six primitives, the page folder convention, the nine data states, the agent contract, one DOM. 0.2 adds capability without adding a second pattern for anything that already has one."
schema           = "Core validation uses the Standard Schema interface (~standard.validate) so any compliant library works. Rex field helpers are built on zod/mini so the core stays small. JSON Schema is produced at manifest build time on the server or CLI with z.toJSONSchema when the schema is zod, or from a declared jsonSchema otherwise. zod 4 is a peer dependency."
reactivity       = "Rex stays on React 19. The React Compiler is enabled by the Vite plugin so a value change re-renders only what reads it. Shared state uses a store() primitive on useSyncExternalStore. No signals library is introduced."
rendering        = "Each page declares render: ssr (default), csr, ssg or static. ssr streams with renderToReadableStream and hydrates; ssg prerenders at build with optional revalidate seconds for on-demand regeneration; static is ssg with no hydration and ships zero page JavaScript, so its actions work through forms. Routing, loaders and the sidecar behave identically in every mode."
loaders          = "Data loading is declared in page.ts as load: a map of names to read actions. On the server loaders run in process during SSR and are dehydrated into the HTML; on the client they seed TanStack Query, which dedupes requests. Mutating actions invalidate what they declare. There is no second data primitive."
forms            = "Every action is also reachable as an HTML form post at /rex/form/<action>. ActionForm renders a real form that works without JavaScript and is enhanced by useAct when JavaScript runs. Irreversible actions get a server-rendered confirmation page on the form route. CSRF is a double-submit cookie."
runtimes         = "rex/server is fetch-only: Request in, Response out, no node: imports. Adapters live under rex/server/node, rex/server/bun, rex/server/deno and rex/server/edge. rex build --target picks the adapter and output layout."
splitting        = "Each page is its own chunk, loaded lazily behind a Suspense boundary whose fallback is the page's loading state. Each region is wrapped in an error boundary that maps to the page's recoverable-error state. Budgets are declared in rex.config and enforced by rex build."
dx               = "Every framework error carries a code (REX followed by three digits), a message naming the file and symbol, a hint and a docs link; the Vite overlay and the CLI show a source frame. Dev mode mounts a devtools overlay. HMR keeps component state because pages, regions and parts are ordinary modules. rex/testing wraps Testing Library and a real in-process server."
config           = "rex.config.ts default-exports defineConfig({...}) from rex/config, validated with a code-carrying error. A bare Hono app default export still works in 0.2 with a deprecation warning and a codemod."
a11y_i18n        = "On navigation focus moves to the page heading and a route announcer speaks the title. The checker gains accessibility rules and the walk runs axe. i18n is messages per locale in app/locales, a locale resolved from the URL prefix, cookie or Accept-Language, and labels and titles that may be message keys."
styling          = "Tokens remain the default. CSS Modules, Tailwind 4 and runtime CSS-in-JS all work; the token rule only governs raw color and spacing literals. SSR emits the page's stylesheet links in the head before streaming so there is no flash."
security         = "Output is escaped by React; raw HTML needs unsafeHtml() and the checker reports any other dangerouslySetInnerHTML. RPC and form posts check Origin. A per-request CSP nonce is applied to every inline script Rex emits. Action handlers and anything under app/server never reach the client bundle; rex build fails on a leaked secret or a server-only import."
observability    = "createRexServer accepts a telemetry option carrying an OpenTelemetry tracer (optional peer @opentelemetry/api) and a logger. Spans cover action invocation, loaders and renders; audit records carry the trace id. The client exposes onOutcome and onNavigate hooks."
supply_chain     = "License MIT. Minimal runtime dependencies; React, TanStack Query, Vite, zod and TypeScript are peers; Drizzle, libsql, OpenTelemetry and adapters are optional peers. CI runs typecheck, tests, check, audit and license review. Releases are published with npm provenance from a GitHub Actions workflow."
ui               = "rex new installs DesignX UI (theme plus a base component set) from its registry into app/components/ui with Tailwind 4, under ui: designx (default) or none. The demo uses DesignX. Rex's own shell, palette, confirmation and outcome components stay token-styled and are overridable through chrome.components."
interop          = "A part can be exported as a custom element with defineElement, a Rex page can be mounted into a foreign app with mountRexPage, and parts may use custom elements and refs to plain DOM. This is also the incremental adoption path."
modern           = "Img requires width and height and lazy-loads by default; fonts declared in rex.config are preloaded with font-display swap; Script carries a loading strategy. Route changes use the View Transitions API and intercept the Navigation API when present. A text renderer serves every page as markdown for terminal agents."
versioning       = "Semantic versioning. deprecated() warns once per code. rex migrate runs registered codemods built on the TypeScript compiler API; the first migrates 0.1 apps. Governance, maintainers, security policy and code of conduct files are part of the package repository."
vitals           = "The operability walk measures LCP, CLS and INP with the web-vitals library on the built demo and fails above 2500 ms, 0.1 and 200 ms; a Lighthouse run requires performance 90 and accessibility 95 or higher. Reports are committed."

[design]
module_layout      = "Wave 0 splits the three entry points so later waves touch disjoint files. vite/: plugin.ts assembles hooks from vite/hooks.ts (ordered list); app-module.ts, entry-module.ts, resolve.ts, scan.ts, compiler.ts, split.ts, ssr.ts, prerender.ts, boundary.ts, budgets.ts, css.ts; index.ts re-exports. server/: app.ts composes createRexServer from server/routes.ts (ordered route list) and server/middleware.ts (ordered list); routes/manifest.ts, rpc.ts, health.ts, form.ts, render.ts, pages-text.ts, dev.ts; middleware/security.ts, telemetry.ts; adapters/node.ts, bun.ts, deno.ts, edge.ts, static-cache.ts; index.ts re-exports and must stay fetch-only. client/: entry.tsx (createRexEntry over client/providers.ts list), shell.tsx composed from client/shell/*.tsx registered in client/shell/slots.ts; new client features live in their own file and register in one list."
config_schema      = "rex/config exports defineConfig and RexConfig: { app, server?: (app) => Hono, render?: { default: ssr|csr|ssg|static }, budgets?: { core, client, page }, security?: { csp: strict|report|off, origins: string[], headers?: Record }, i18n?: { locales, default, routing: prefix|none }, images?: { sizes, formats }, fonts?: FontSpec[], telemetry?: { tracer?, logger? }, ui?: designx|none, client?: { apiOrigin? }, compiler?: boolean, devtools?: boolean }. Validation errors are REX1xx."
page_options       = "page() gains render, revalidate (seconds, ssg only), paths (() => params[] for dynamic ssg), load (Record<string, ReadAction | { action, input: (params) => input }>), cache ({ staleTime }), transition (view|none), and chrome.components overrides. Declaration validation errors are REX2xx."
action_options     = "action() gains form?: { redirect?: string, confirmTitle?: string } and an optional jsonSchema override. Read actions are effect read and are what load may reference."
rendering_pipeline = "GET for a page route hits routes/render.ts: resolve page, policy and locale; run loaders in process; render the app with renderToReadableStream inside a Suspense tree, with the head carrying CSS links from the Vite manifest, preloads, the CSP nonce and the dehydrated loader data in a script of type application/rex+data; the sidecar is server-rendered too. csr pages render the shell only and hydrate the page client-side. ssg pages are written by prerender.ts at build to dist/client/<route>/index.html and served by static-cache.ts with revalidate honoured through stale-while-revalidate regeneration. static pages omit the page chunk and the hydration script."
hydration          = "The entry calls hydrateRoot when the document carries data-rex-ssr, otherwise createRoot. Loader data is read from application/rex+data and hydrated into the QueryClient before the first render. A hydration mismatch is surfaced as REX310 in dev."
loaders_api        = "useLoader(page, name) returns the TanStack query for that loader with inferred output type. useLoaders(page) returns all. The runtime registers loader queries under keys [loader, page.id, name, inputDigest]. Mutating actions declaring invalidates still work; loaders also accept invalidatedBy for explicit keys."
forms_protocol     = "POST /rex/form/<action> accepts multipart or urlencoded FormData, coerces it with the action input schema (numbers, booleans, arrays by repeated names), checks the CSRF double-submit cookie rex-csrf against the _csrf field, checks Origin, evaluates policy, runs the action, writes the outcome into a rex-outcome cookie and redirects to the form.redirect or the Referer. Irreversible actions without _confirm render a server-side confirmation page listing the input; its Confirm button posts with _confirm. ActionForm renders hidden _csrf and the action id and, with JavaScript, intercepts submit through useAct."
splitting_api      = "rex:app imports each page's view, states, regions and overlays through dynamic import; PageHost renders React.lazy components under Suspense with the page loading state as fallback; each Region has an error boundary that calls the page's recoverable-error state with the error and a retry that remounts the region. rex build prints a chunk table (name, raw, gzip, budget) and exits 1 over budget."
errors             = "RexError extends Error with code, hint, docs (https://rex.sidioralabs.com/errors/<code>), file, line and column when known. Codes: REX1xx config, REX2xx declarations, REX3xx runtime, REX4xx server, REX5xx checker, REX6xx CLI. docs/errors.md is generated from the catalog in core/errors.ts."
devtools           = "RexDevtools mounts only when import.meta.env.DEV and config.devtools is not false; toggle with shift+mod+d; panels: Manifest, Page (state, params, loaders), Sidecar (live JSON), Outcomes, Queries, Renders (React Profiler durations per region), Audit (tail from GET /rex/dev/audit, dev only). It is tree-shaken from production builds."
testing_api        = "rex/testing exports createTestApp(registry, { actor, server? }), renderPage(app, pageId, { params, locale, density }), renderRegion(app, pageId, regionName, props), testServer(app) returning fetch and the ledger, and readSidecar(container). All build on real createRexServer and Testing Library."
state_api          = "store(id, { initial, expose? }) returns a typed store with get, set, update, subscribe and a useStore hook; exposed stores appear under state.stores in the sidecar; stores are serialisable and reset per test."
interop_api        = "defineElement(tagName, Part, { props }) registers a custom element rendering the part with createRoot; mountRexPage(element, app, pageId, options) mounts a full Rex page with its providers into a foreign DOM node and returns unmount; Native is a forwardRef component exposing the DOM node for plain JS. Custom element tags in parts are allowed by the checker when they also carry tabindex or a declared keyboard equivalent."
navigation         = "RexRoutes wraps route changes in document.startViewTransition when transition is view and the API exists; when window.navigation exists it intercepts same-origin navigate events; after commit it focuses the page heading (or main) and updates the announcer live region with the page title. Both behaviours are testable in happy-dom through injected globals of the real shapes."
i18n_api           = "app/locales/<locale>.json holds flat message maps with ICU-style placeholders handled by a small formatter (no runtime library). useLocale(), useT() and t(key, values). Labels, titles and messages starting with msg: are resolved through the active locale, including in the sidecar and palette. With routing prefix the router mounts every page under /:locale and nav.to keeps the prefix."
a11y_rules         = "Checker rules a11y/img-alt, a11y/control-name, a11y/label-for, a11y/heading-order, a11y/no-positive-tabindex, a11y/no-autofocus-outside-overlay. The walk runs axe-core on every page in both densities and fails on serious or critical violations."
styling_support    = "The Vite plugin enables CSS Modules (default Vite behaviour) and, when ui is designx or tailwind is true, @tailwindcss/vite. SSR reads the Vite client manifest to emit link elements for the entry and the page chunk before the body. The token rule has allow lists for CSS Modules class references and Tailwind utilities that resolve to tokens."
security_impl      = "middleware/security.ts: Origin check for POST on /rex/* (same origin or security.origins), CSRF for forms, per-request nonce exposed through RexContext and applied by routes/render.ts to inline scripts and by the Vite dev server through html transform, Content-Security-Policy built from config (strict: default-src self, script-src self nonce-<n>, style-src self unsafe-inline for tokens, connect-src self plus apiOrigin, img-src self data: blob:), plus X-Content-Type-Options, Referrer-Policy and Permissions-Policy defaults. boundary.ts strips handler from action modules in client builds, throws REX440 when a client module imports rex/server, app/server or a module tagged import 'rex/server-only', and the build scans the client output for process.env references not prefixed VITE_ and for the names in security.secretNames."
telemetry_impl     = "middleware/telemetry.ts wraps each RPC procedure, form post, loader run and SSR render in a span named rex.action, rex.form, rex.loader, rex.render with attributes rex.action.id, rex.actor.id, rex.page.id, rex.outcome; the audit ledger record gains traceId and spanId; logger has debug, info, warn, error and defaults to console with a rex: prefix."
media_api          = "Img props: src, alt, width, height (required), priority (sets fetchpriority high and a preload link in SSR), sizes and srcSet passthrough, loading lazy and decoding async by default. Script props: src, strategy beforeHydration|afterHydration|idle, nonce applied automatically. Fonts from rex.config emit preload links and a font-face block with font-display swap. Checker rule media/no-raw-img reports img elements in parts and regions."
text_renderer      = "GET /rex/pages/<id>.md renders a page as markdown for text-only agents: title, route, current data state for the actor, regions with their actions (id, label, effect, allowed, how to invoke by URL and form), overlays, and the sidecar JSON in a fenced block. It is the second rendering target and proves the core is renderer-neutral."
platform_output    = "rex build --target node (default), edge, bun, deno or static. static writes dist/client only and bakes client.apiOrigin into the entry so the client talks to a remote server; the server enables CORS for security.origins with credentials. docs/platforms.md covers Electron, Tauri and Capacitor using these outputs."
migrate            = "rex migrate [--from 0.1] lists and applies codemods from cli/codemods/*.ts using the TypeScript compiler API, idempotently: 0.1-config (wrap a Hono default export in defineConfig), 0.1-page-render (add render: ssr explicitly only when the app relied on csr behaviour, otherwise nothing), 0.1-raw-img (img to Img with width and height placeholders flagged as REX610 for the author)."
budgets            = "Defaults: core 15 KB gzip (rex entry, zod/mini included, React excluded), client 30 KB gzip (rex/client excluding React, TanStack Query, cmdk, wouter, oRPC client), page 50 KB gzip per page chunk. The size test builds the entries with Vite's build API and asserts the budgets; rex build asserts the app's page budgets."
vitals_gate        = "examples/demo/e2e/vitals.spec.ts loads each page in Chromium with the web-vitals attribution build injected, interacts (opens the palette, invokes a reversible action) and reads LCP, CLS and INP; thresholds 2500 ms, 0.1, 200 ms. e2e/lighthouse.ts runs lighthouse programmatically against the running build for each page and asserts performance 90 and accessibility 95 or higher; both write JSON to e2e/report."
shared_lists       = "Registration lists and export maps are shared files that any task may append one entry to without listing them in touches: vite/hooks.ts, server/routes.ts, server/middleware.ts, client/shell/slots.ts, client/providers.ts, check/rules/index.ts, cli/generators.ts, cli/index.ts, every index.ts under packages/rex/src, packages/rex/package.json, examples/demo/package.json, the root package.json and pnpm-lock.yaml. Generated files examples/demo/.rex/manifest.json and examples/demo/AGENTS.md are regenerated with rex manifest by whoever changes the demo. Merge conflicts in shared files are resolved by the feature manager by union; conflicts in generated files by regenerating."
release            = "packages/rex/package.json: version 0.2.0, license MIT, sideEffects false except CSS, exports with types first, files dist only, publishConfig provenance true. .github/workflows/ci.yml runs install, typecheck, test, check, walk, vitals, audit and license review on push and pull request; release.yml publishes on a v* tag with --provenance using OIDC. The pack test runs npm pack --dry-run and asserts every export resolves in the tarball with its types."

