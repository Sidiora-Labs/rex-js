file = "README.md"
line = 30
severity = "wrong"
stale = "| CLI | commander |"
actual = "The CLI uses its own parser: `RexCommand` in packages/rex/src/cli/args.ts (imported at packages/rex/src/cli/index.ts:7, used at :79). packages/rex/package.json has no commander in dependencies, devDependencies or peerDependencies, and packages/rex/src/cli/cli.test.ts:178-186 (\"depends on no argument parser and no TypeScript loader\") asserts commander is absent. (docs/cli.md:3 repeats the stale \"built on commander\".)"
fix = "| CLI | a built-in argument parser (`RexCommand` in `packages/rex/src/cli/args.ts`); no commander dependency |"

