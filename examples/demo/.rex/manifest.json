                  "type": "string",
                  "x-rex-field": "money"
                },
                "symbol": {
                  "maxLength": 12,
                  "minLength": 1,
                  "type": "string",
                  "x-rex-field": "text"
                },
                "valueUsd": {
                  "format": "decimal",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
