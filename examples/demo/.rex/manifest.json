{
  "actions": [
    {
      "effect": "read",
      "form": null,
      "id": "load-wallet",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {},
        "type": "object"
      },
      "invalidates": [],
      "label": "Load wallet",
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "account": {
            "additionalProperties": false,
            "properties": {
              "address": {
                "minLength": 1,
                "type": "string",
                "x-rex-field": "text"
              },
              "hideDust": {
                "type": "boolean",
                "x-rex-field": "boolean"
              },
              "id": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                "type": "string",
                "x-rex-field": "id"
              },
              "lastTransfer": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string",
                    "x-rex-field": "text"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "minLength": 1,
                "type": "string",
                "x-rex-field": "text"
              },
              "sendContact": {
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                "type": "string",
                "x-rex-field": "ref",
                "x-rex-ref": "contact"
              },
              "sendToken": {
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                "type": "string",
                "x-rex-field": "ref",
                "x-rex-ref": "token"
              }
            },
            "required": [
              "id",
              "name",
              "address",
              "hideDust",
              "sendToken",
              "sendContact",
              "lastTransfer"
            ],
            "type": "object"
          },
          "contacts": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "address": {
                  "minLength": 1,
                  "type": "string",
                  "x-rex-field": "text"
                },
                "id": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "type": "string",
                  "x-rex-field": "id"
                },
                "name": {
                  "minLength": 1,
                  "type": "string",
                  "x-rex-field": "text"
                }
              },
              "required": [
                "id",
                "name",
                "address"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "tokens": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "balance": {
                  "format": "decimal",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                  "type": "string",
                  "x-rex-field": "money"
                },
                "dust": {
                  "type": "boolean",
                  "x-rex-field": "boolean"
                },
                "id": {
                  "maxLength": 128,
                  "minLength": 1,
